# ─────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────
# Supabase Transaction mode pooler (port 6543) — Prisma runtime queries
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase Session mode (port 5432) — Prisma Migrate (DDL statements require direct connection)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → Session
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────────
# AUTH.JS v5
# ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Required in production — set to your canonical domain
# Auth.js v5 uses AUTH_URL; NEXTAUTH_URL is the legacy fallback
AUTH_URL="https://yourdomain.com"
NEXTAUTH_URL="https://yourdomain.com"

# Google OAuth (create at https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─────────────────────────────────────────────────
# STRIPE
# ─────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Get from https://dashboard.stripe.com/webhooks after registering:
# Endpoint: https://yourdomain.com/api/webhooks/stripe
# Events to subscribe:
#   checkout.session.completed
#   checkout.session.expired
#   payment_intent.payment_failed
#   customer.subscription.updated
#   customer.subscription.deleted
#   account.updated
STRIPE_WEBHOOK_SECRET="whsec_..."

# Subscription tier price IDs — create recurring prices in your Stripe dashboard
# Products: Starter ($9/mo), Pro ($29/mo), Prime ($49/mo), Team, Label ($199/mo)
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_PRIME="price_..."
STRIPE_PRICE_ID_TEAM="price_..."
STRIPE_PRICE_ID_LABEL="price_..."

# ─────────────────────────────────────────────────
# OPENAI (AI scoring, recommendations, chat)
# ─────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
# If not set, AI features degrade gracefully
OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────────
# REDIS (caching + BullMQ background jobs)
# ─────────────────────────────────────────────────
# Upstash Redis (recommended for Vercel): https://upstash.com
# Or any ioredis-compatible URL: redis://user:pass@host:6379
# If not set, caching and background jobs are disabled gracefully
REDIS_URL="rediss://default:TOKEN@hostname:6380"

# ─────────────────────────────────────────────────
# EMAIL + ANALYTICS
# ─────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="Epic Music Space <noreply@epicmusicspace.com>"
POSTHOG_API_KEY="phc_..."
POSTHOG_HOST="https://us.i.posthog.com"

# ─────────────────────────────────────────────────
# SUPABASE (Realtime subscriptions + File Storage)
# ─────────────────────────────────────────────────
# Auth and DB are handled by NextAuth + Prisma.
# Supabase is used for browser-side Realtime channels AND server-side file storage.
# If not set, real-time and file upload features are disabled (everything else works normally).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service role key — used server-side ONLY for Storage operations (never expose to browser)
# Get from Supabase project settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ─────────────────────────────────────────────────
# CRON JOBS (Vercel Cron security)
# ─────────────────────────────────────────────────
# Used to authenticate /api/cron/* endpoints called by Vercel Crons.
# Generate with: openssl rand -base64 32
# Vercel automatically sends this as "Authorization: Bearer <value>" for cron invocations.
CRON_SECRET="your-cron-secret-here"

# Optional override for local Stripe webhook forwarding
STRIPE_WEBHOOK_FORWARD_URL="http://localhost:3000/api/webhooks/stripe"

# ─────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────
# Canonical public URL used across the app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Legacy fallback for older codepaths and scripts
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────
# MUX (video uploads + adaptive streaming)
# ─────────────────────────────────────────────────
# Get from https://dashboard.mux.com/settings/access-tokens
# If not set, the video upload button on posts shows a clear "not configured" error.
MUX_TOKEN_ID="..."
MUX_TOKEN_SECRET="..."
# Mux signs webhooks with HMAC-SHA256. Get from the webhook configuration in Mux dashboard.
# Configure webhook to: https://yourdomain.com/api/webhooks/mux
# Events: video.upload.asset_created, video.asset.ready, video.asset.errored
MUX_WEBHOOK_SIGNING_SECRET="..."

# ─────────────────────────────────────────────────
# LIVEKIT (live audio/listening rooms)
# ─────────────────────────────────────────────────
# Get from https://cloud.livekit.io
# If not set, /rooms still renders but joining a room is disabled.
LIVEKIT_API_KEY="API..."
LIVEKIT_API_SECRET="..."
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"

# Optional: route LiveKit cloud recordings to your own S3-compatible bucket
LIVEKIT_RECORDING_S3_ACCESS_KEY=""
LIVEKIT_RECORDING_S3_SECRET=""
LIVEKIT_RECORDING_S3_BUCKET=""
LIVEKIT_RECORDING_S3_REGION=""
LIVEKIT_RECORDING_S3_ENDPOINT=""
LIVEKIT_RECORDING_PUBLIC_BASE_URL=""

# ─────────────────────────────────────────────────
# ADMIN / OPERATIONS
# ─────────────────────────────────────────────────
# One-time bootstrap to grant the first ADMIN account.
# Generate with: openssl rand -base64 32
# Call: curl -X POST https://yourdomain.com/api/admin/bootstrap -H "Authorization: Bearer $SECRET"
# Then UNSET this env var to disable the endpoint.
ADMIN_BOOTSTRAP_SECRET=""

# Salt used when hashing IPs for ad-impression tracking.
# Generate with: openssl rand -base64 32
AD_TRACKING_SALT="change-me"

# Optional: shared token used for service-to-service calls between cron + internal routes.
INTERNAL_API_TOKEN=""

# Optional: webhook URL (Slack/Discord) used by /api/internal/auth-alert + reliability-alert.
AUTH_ALERT_WEBHOOK_URL=""

# Minimum payout amount in USD before /api/payout/request is allowed (default: 10).
MIN_CREATOR_PAYOUT_USD="10"

# ─────────────────────────────────────────────────
# AUTO-CLIP / VIRAL HIGHLIGHTS (optional)
# ─────────────────────────────────────────────────
# Thresholds for auto-clip generation pipeline.
HIGHLIGHT_VIRAL_THRESHOLD="50"
HIGHLIGHT_CLIP_DURATION_SECONDS="30"
AUTO_RENDER_CLIP_THRESHOLD="100"
AUTO_POST_CLIP_THRESHOLD="500"
AUTO_POST_PLATFORMS=""

# ─────────────────────────────────────────────────
# ELEVENLABS (optional AI voice announcer)
# ─────────────────────────────────────────────────
# If not set, AI announcer features degrade gracefully.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID=""

# ─────────────────────────────────────────────────
# SENTRY (error tracking) — optional but strongly recommended
# ─────────────────────────────────────────────────
# Create a project at https://sentry.io. Use the same DSN for client + server.
# If unset, error tracking is silently disabled and global-error still logs to stderr.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Required ONLY for source-map upload during build (otherwise leave blank).
# Create at https://sentry.io/orgredirect/organizations/:org/settings/auth-tokens/
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─────────────────────────────────────────────────
# ADMIN IP ALLOWLIST (optional, defence-in-depth)
# ─────────────────────────────────────────────────
# Comma-separated list of IPs allowed to call /api/admin/*. If unset, only the
# session role check applies. Use to lock admin actions to your office/VPN.
ADMIN_IP_ALLOWLIST=""
