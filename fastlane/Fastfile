# fastlane/Fastfile
# Epic Music Space — native release automation
#
# Usage:
#   iOS TestFlight:      bundle exec fastlane ios beta
#   Android Play Beta:  bundle exec fastlane android beta
#   iOS App Store:      bundle exec fastlane ios release
#   Android Production: bundle exec fastlane android release
#
# Required secrets (GitHub Actions / local .env):
#   IOS:
#     APP_STORE_CONNECT_API_KEY_KEY_ID
#     APP_STORE_CONNECT_API_KEY_ISSUER_ID
#     APP_STORE_CONNECT_API_KEY_KEY          — base64-encoded .p8 key content
#     MATCH_GIT_URL                          — private repo for code signing certs
#     MATCH_PASSWORD                         — encryption passphrase
#     KEYCHAIN_PASSWORD                      — temporary CI keychain
#
#   Android:
#     ANDROID_KEYSTORE_BASE64                — base64-encoded release keystore
#     ANDROID_KEYSTORE_PASSWORD
#     ANDROID_KEY_ALIAS
#     ANDROID_KEY_PASSWORD
#     GOOGLE_PLAY_JSON_KEY_BASE64            — base64-encoded service account JSON

default_platform(:ios)

# ─────────────────────────────────────────────────────────────────────────────
# Shared helpers
# ─────────────────────────────────────────────────────────────────────────────

def version_from_tag
  tag = ENV["GITHUB_REF_NAME"] || `git describe --tags --abbrev=0`.strip
  tag.gsub(/^v/, "")
end

def build_number_from_run
  (ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")).to_s
end

# ─────────────────────────────────────────────────────────────────────────────
# iOS
# ─────────────────────────────────────────────────────────────────────────────

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Sync code signing certificates and provisioning profiles"
  lane :sync_signing do
    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_KEY"] || ""),
      in_house:    false,
    )

    create_keychain(
      name:            "ems_release",
      password:        ENV["KEYCHAIN_PASSWORD"],
      default_keychain: true,
      unlock:          true,
      timeout:         3600,
    ) if ENV["CI"]

    match(
      type:             "appstore",
      app_identifier:   "com.epicmusicspace.app",
      git_url:          ENV["MATCH_GIT_URL"],
      password:         ENV["MATCH_PASSWORD"],
      keychain_name:    ENV["CI"] ? "ems_release" : nil,
      keychain_password: ENV["CI"] ? ENV["KEYCHAIN_PASSWORD"] : nil,
      readonly:         ENV["CI"],
      api_key:          api_key,
    )
  end

  desc "Build and upload a beta to TestFlight"
  lane :beta do
    sync_signing

    increment_version_number(
      version_number: version_from_tag,
      xcodeproj:      "apps/mobile/ios/App/App.xcodeproj",
    )
    increment_build_number(
      build_number: build_number_from_run,
      xcodeproj:    "apps/mobile/ios/App/App.xcodeproj",
    )

    build_app(
      workspace:          "apps/mobile/ios/App/App.xcworkspace",
      scheme:             "App",
      configuration:      "Release",
      export_method:      "app-store",
      output_directory:   "output/ios",
      output_name:        "EpicMusicSpace.ipa",
    )

    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_KEY"] || ""),
    )

    upload_to_testflight(
      api_key:          api_key,
      ipa:              "output/ios/EpicMusicSpace.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Submit to App Store for review"
  lane :release do
    beta  # Reuses beta lane to build + upload, then submits for review

    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_KEY"] || ""),
    )

    deliver(
      api_key:              api_key,
      submit_for_review:    true,
      automatic_release:    false,
      skip_screenshots:     true,
      skip_metadata:        false,
      metadata_path:        "fastlane/metadata/ios",
      force:                true,
    )
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Android
# ─────────────────────────────────────────────────────────────────────────────

platform :android do
  desc "Build and upload a beta to Google Play (internal track)"
  lane :beta do
    # Decode keystore
    keystore_path = "/tmp/ems_release.keystore"
    File.write(keystore_path, Base64.decode64(ENV["ANDROID_KEYSTORE_BASE64"] || ""))

    gradle(
      task:            "bundle",
      build_type:      "Release",
      project_dir:     "apps/mobile/android",
      properties: {
        "android.injected.signing.store.file"     => keystore_path,
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias"      => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password"   => ENV["ANDROID_KEY_PASSWORD"],
        "versionName"                              => version_from_tag,
        "versionCode"                              => build_number_from_run,
      },
    )

    # Decode Play Store service account JSON
    json_path = "/tmp/play_service_account.json"
    File.write(json_path, Base64.decode64(ENV["GOOGLE_PLAY_JSON_KEY_BASE64"] || ""))

    upload_to_play_store(
      package_name:     "com.epicmusicspace.app",
      track:            "internal",
      aab:              "apps/mobile/android/app/build/outputs/bundle/release/app-release.aab",
      json_key:         json_path,
      skip_upload_apk:  true,
    )

    File.delete(keystore_path, json_path)
  end

  desc "Promote internal build to production on Google Play"
  lane :release do
    json_path = "/tmp/play_service_account.json"
    File.write(json_path, Base64.decode64(ENV["GOOGLE_PLAY_JSON_KEY_BASE64"] || ""))

    upload_to_play_store(
      package_name:    "com.epicmusicspace.app",
      track:           "internal",
      track_promote_to: "production",
      json_key:        json_path,
      skip_upload_apk: true,
      skip_upload_aab: true,
    )

    File.delete(json_path)
  end
end
