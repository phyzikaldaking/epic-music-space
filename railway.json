{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run railway:build",
    "watchPatterns": [
      "apps/web/**",
      "packages/db/**",
      "packages/utils/**",
      "scripts/ops/railway.mjs",
      "package.json",
      "package-lock.json",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "npm run railway:predeploy",
    "startCommand": "npm run railway:start"
  }
}
