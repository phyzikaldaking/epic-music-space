enum RoomNoteCategory {
  GENERAL
  MIX
  MASTER
  SONGWRITING
  ARRANGEMENT
  PERFORMANCE
}

// ─────────────────────────────────────────────────────────────
// Services marketplace — engineers offer mix/master, producers sell
// templates / beats / sample packs. Listings are bookable; an order
// is paid via Stripe and a Transaction + RevenueEvent is recorded.
// ─────────────────────────────────────────────────────────────

model ServiceListing {
  id            String              @id @default(cuid())
  providerId    String
  provider      User                @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Cascade)
  kind          ServiceListingKind
  title         String
  description   String              @db.Text
  priceUsd      Decimal             @db.Decimal(10, 2)
  deliveryDays  Int                 @default(7)
  exampleAudioUrl String?
  coverUrl      String?
  // For non-bespoke goods (templates / beats / kits): instant download.
  // Set when kind is template/beat/kit. URL surfaced after purchase.
  downloadUrl   String?             @db.Text
  status        ServiceListingStatus @default(LIVE)
  totalSold     Int                 @default(0)
  rating        Float?
  ratingCount   Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  orders        ServiceOrder[]
  reviews       ServiceReview[]

  @@index([status, kind, createdAt])
  @@index([providerId, status])
}

enum ServiceListingKind {
  MIX                 // engineer service
  MASTER              // engineer service
  MIX_MASTER_BUNDLE   // engineer service
  PRODUCER_TEMPLATE   // FL/Logic/Ableton project file
  BEAT                // producer-made beat license
  DRUM_KIT
  SAMPLE_PACK
  LESSON              // 1:1 session
}

enum ServiceListingStatus {
  LIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

model ServiceOrder {
  id           String             @id @default(cuid())
  listingId    String
  listing      ServiceListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User               @relation("ServiceBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  providerId   String
  provider     User               @relation("ServiceProviderOrders", fields: [providerId], references: [id], onDelete: Cascade)
  priceUsd     Decimal            @db.Decimal(10, 2)
  status       ServiceOrderStatus @default(PENDING)
  briefText    String?            @db.Text  // buyer's notes (BPM, key, references, etc.)
  briefUrl     String?            @db.Text  // upload link for stems
  deliverableUrl String?          @db.Text  // provider's final delivery
  deliveredAt  DateTime?
  completedAt  DateTime?                    // buyer accepted (or auto-accepted)
  acceptDeadline DateTime?                  // 14 days after deliveredAt
  revisionsUsed Int               @default(0)
  stripeSessionId      String?    @unique
  stripePaymentIntentId String?   @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages     ServiceOrderMessage[]
  revisions    ServiceOrderRevision[]
  review       ServiceReview?

  @@index([buyerId, status])
  @@index([providerId, status])
  @@index([listingId, status])
  @@index([status, acceptDeadline])
}

model ServiceOrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser  User     @relation("ServiceMessageAuthor", fields: [fromUserId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  attachmentUrl String? @db.Text
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ServiceOrderRevision {
  id        String   @id @default(cuid())
  orderId   String
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revisionNumber Int           // 1 = first delivery, 2 = first revision, ...
  deliverableUrl String  @db.Text
  message   String?  @db.Text
  deliveredAt DateTime @default(now())

  @@unique([orderId, revisionNumber])
  @@index([orderId])
}

model ServiceReview {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId   String
  listing     ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("ServiceReviewer", fields: [buyerId], references: [id], onDelete: Cascade)
  providerId  String
  rating      Int      // 1..5
  body        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([providerId, createdAt])
}

enum ServiceOrderStatus {
  PENDING               // checkout started, payment not confirmed
  PAID                  // payment received, awaiting provider work
  IN_PROGRESS           // provider acknowledged or revising
  DELIVERED             // deliverableUrl set, awaiting buyer review
  REVISION_REQUESTED    // buyer asked for changes
  COMPLETED             // buyer accepted (or auto-accepted) — payout finalized
  REFUNDED              // refunded via Stripe
  CANCELLED             // either side cancelled before delivery
}

// ─────────────────────────────────────────
// USER TIMELINE / POSTS
// ─────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  // Optional song attachment (artists posting about a track)
  songId    String?
  // Media — at most one block per post (handled in app code)
  imageUrl  String?
  // Mux video — populated by webhook when asset is ready
  muxUploadId  String?  @unique
  muxAssetId   String?  @unique
  muxPlaybackId String? @unique
  videoStatus  PostVideoStatus @default(NONE)
  videoDurationSec Int?
  videoAspectRatio String?
  isPublished Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  PostComment[]
  likes     PostLike[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([videoStatus])
}

enum PostVideoStatus {
  NONE
  UPLOADING   // direct upload created, file in transit / awaiting Mux pickup
  PROCESSING  // Mux is encoding
  READY       // playable
  FAILED
}

model PostComment {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User     @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body     String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model PostLike {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// ─────────────────────────────────────────
// TRACK COMMENTS & LIKES
// ─────────────────────────────────────────

model TrackComment {
  id       String   @id @default(cuid())
  songId   String
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  authorId String
  author   User     @relation("TrackCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body     String   @db.Text
  createdAt DateTime @default(now())

  @@index([songId, createdAt])
}

model TrackLike {
  id       String   @id @default(cuid())
  songId   String
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("TrackLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([songId, userId])
  @@index([songId])
}

// ─────────────────────────────────────────
// ADMIN AUDIT LOG
// ─────────────────────────────────────────

model AdminActionLog {
  id        String   @id @default(cuid())
  adminId   String   // user id of the admin who took the action
  adminEmail String? // snapshot, in case the admin user is later deleted
  action    String   // e.g. "song.delete", "auction.cancel", "user.role_change"
  target    String?  // resource id targeted (songId, auctionId, userId, etc.)
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([target])
}

// ─────────────────────────────────────────
// EMAIL DRIP SEQUENCE TRACKING
// ─────────────────────────────────────────

model EmailDripSent {
  id        String   @id @default(cuid())
  userId    String
  step      String   // "welcome_day_0", "tips_day_1", "payout_day_3"
  sentAt    DateTime @default(now())

  @@unique([userId, step])
  @@index([sentAt])
}

// ─────────────────────────────────────────
// STATUS PAGE INCIDENTS
// ─────────────────────────────────────────

model StatusIncident {
  id          String        @id @default(cuid())
  title       String
  body        String?       @db.Text
  severity    IncidentSeverity @default(INVESTIGATING)
  resolvedAt  DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([resolvedAt])
  @@index([createdAt])
}

enum IncidentSeverity {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

// ─────────────────────────────────────────
// SUPPORT TICKETS
// ─────────────────────────────────────────

model SupportTicket {
  id           String   @id @default(cuid())
  ticketCode   String   @unique // human-friendly e.g. "EMS-7H3K"
  email        String
  name         String?
  subject      String
  body         String   @db.Text
  userId       String?  // null when sender isn't logged in
  status       SupportTicketStatus @default(OPEN)
  ip           String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum SupportTicketStatus {
  OPEN
  REPLIED
  RESOLVED
  SPAM
}

// ─────────────────────────────────────────
// SAVED TRACKS (wishlist / liked but not licensed)
// ─────────────────────────────────────────

model SavedTrack {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  @@unique([userId, songId])
  @@index([userId, createdAt])
  @@index([songId])
}

// ─────────────────────────────────────────
// VERSUS CHALLENGES (cross-artist consent flow)
// ─────────────────────────────────────────

model VersusChallenge {
  id              String    @id @default(cuid())
  challengerId    String    // user.id of the artist who initiated
  challengerSongId String   // song.id they're putting up
  opponentId      String    // user.id of the artist being challenged
  opponentSongId  String?   // song.id the opponent picks on accept
  status          VersusChallengeStatus @default(PENDING)
  message         String?   @db.Text
  durationHours   Int       @default(24)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime  // PENDING expires after 48h
  acceptedAt      DateTime?
  declinedAt      DateTime?
  matchId         String?   @unique // populated once the resulting VersusMatch is created

  @@index([opponentId, status])
  @@index([challengerId, status])
  @@index([expiresAt])
}

enum VersusChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────
// VERSUS TIPS (tip-with-vote)
// ─────────────────────────────────────────

model VersusTip {
  id              String   @id @default(cuid())
  matchId         String
  voterId         String
  votedSongId     String
  amountUsd       Decimal  @db.Decimal(10, 2)
  status          VersusTipStatus @default(PENDING)
  stripeSessionId String?  @unique
  stripePaymentIntentId String? @unique
  createdAt       DateTime @default(now())
  paidAt          DateTime?

  @@index([matchId])
  @@index([voterId])
  @@index([status])
}

enum VersusTipStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ── Direct messages ─────────────────────────────────────────────────────
// 1:1 conversation between two users. The pair (userAId, userBId) is
// canonicalised so userAId < userBId — that way (X, Y) and (Y, X) hash to
// the same row and we get an O(1) "get or create" via the unique index.
model Conversation {
  id          String    @id @default(cuid())
  userAId     String
  userBId     String
  userA       User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages    Message[]
  lastMessageAt DateTime @default(now())
  createdAt   DateTime  @default(now())
  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String   @db.Text
  readAt         DateTime?
  createdAt      DateTime @default(now())
  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─────────────────────────────────────────
// EMAIL OUTBOX — guaranteed delivery
// Written BEFORE the Resend API call. A cron flushes PENDING rows that
// weren't confirmed sent within 5 min (delivery gap). Idempotent on
// messageId — prevents duplicates on retry.
// ─────────────────────────────────────────

model EmailOutbox {
  id          String          @id @default(cuid())
  messageId   String          @unique // deterministic — sha256(userId+type+day)
  userId      String?
  to          String
  subject     String
  html        String          @db.Text
  text        String?         @db.Text
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int             @default(0)
  lastError   String?         @db.Text
  sentAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

enum EmailOutboxStatus {
  PENDING   // not yet sent
  SENT      // Resend API confirmed
  FAILED    // max retries exceeded
  SUPPRESSED // recipient bounced / complained
}

// ─────────────────────────────────────────
// PROMO CODE FREEZE — admin freeze control
// Stripe coupon IDs can be frozen to stop all new redemptions.
// ─────────────────────────────────────────

model PromoCodeFreeze {
  id         String   @id @default(cuid())
  couponId   String   @unique // Stripe coupon ID
  frozenBy   String   // admin userId
  frozenAt   DateTime @default(now())
  reason     String?  @db.Text
  unfrozenAt DateTime?
  unfrozenBy String?

  @@index([couponId])
  @@index([frozenAt])
}

// ── Verzuz: head-to-head artist-vs-artist with up to 10 song rounds ──
// Modelled after Swizz Beatz / Timbaland Verzuz: two artists pick a
// curated setlist (up to 10 songs each), and fans vote round-by-round
// on which song wins that head-to-head. Whoever takes the most rounds
// wins the match. Auto-advances on timer; voting on a future round is
// rejected so the experience is paced like a real DJ set.
model VerzuzMatch {
  id            String       @id @default(cuid())
  artistAId     String
  artistBId     String
  artistA       User         @relation("VerzuzArtistA", fields: [artistAId], references: [id], onDelete: Cascade)
  artistB       User         @relation("VerzuzArtistB", fields: [artistBId], references: [id], onDelete: Cascade)
  // Display fields cached at create-time so a profile-rename doesn't
  // change the headline mid-match.
  artistAName   String
  artistBName   String
  // Optional theme — "Hip-hop legends," "Reggaeton kings" etc. Just
  // copy on the stage page; never affects voting eligibility.
  theme         String?
  totalRounds   Int          @default(10)
  currentRound  Int          @default(1)
  // Each round runs `roundDurationSec`. When the round timer expires
  // the cron auto-advances; the artists can never advance early.
  roundDurationSec Int       @default(180)
  status        VerzuzStatus @default(SCHEDULED)
  startsAt      DateTime
  endsAt        DateTime?
  // Event-grade fields. A "MAIN_EVENT" is the planned 10-song-by-10-song
  // showdown with hype reminders, RSVPs, and a host card. "SPEED" is the
  // quick 1-song-vs-1-song format for a casual battle. Defaults to MAIN.
  tier          String       @default("MAIN_EVENT")
  hostNotes     String?
  coverImageUrl String?
  // Counters for cron-driven reminders so we don't double-send.
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?
  reminder5mSentAt  DateTime?
  liveStartSentAt   DateTime?
  rounds        VerzuzRound[]
  votes         VerzuzVote[]
  rsvps         VerzuzRSVP[]
  reactions     VerzuzReaction[]
  messages      VerzuzMessage[]
  createdAt     DateTime     @default(now())
  @@index([status, startsAt])
  @@index([artistAId])
  @@index([artistBId])
}

// "Going" / "Interested" RSVPs drive the pre-event reminder cron and
// give the audience a number to look forward to. One row per (match, user).
model VerzuzRSVP {
  id        String      @id @default(cuid())
  matchId   String
  match     VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String      @default("GOING") // GOING | INTERESTED
  createdAt DateTime    @default(now())
  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

// Live-stream reactions ("🔥", "👏", "🐐"). Append-only; the UI counts
// per-emoji on read. Cap server-side via rate-limit.
model VerzuzReaction {
  id          String      @id @default(cuid())
  matchId     String
  match       VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundNumber Int
  emoji       String
  createdAt   DateTime    @default(now())
  @@index([matchId, roundNumber])
  @@index([matchId, createdAt])
}

// Live audience chat — one row per message. Moderator (either artist)
// can hide rows by flipping isHidden.
model VerzuzMessage {
  id          String      @id @default(cuid())
  matchId     String
  match       VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundNumber Int
  body        String
  isHidden    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  @@index([matchId, createdAt])
  @@index([matchId, roundNumber])
}

enum VerzuzStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

// Two-sided invitation flow that lets cross-artist Verzuz matches actually
// happen. The challenger proposes opponent + theme + setlist + start time;
// the opponent accepts (picking their own setlist) which atomically creates
// the real VerzuzMatch with rounds zipped 1:1. Mirrors VersusChallenge.
model VerzuzChallenge {
  id                       String                @id @default(cuid())
  challengerId             String                // user.id of the artist who initiated
  opponentId               String                // user.id of the artist being challenged
  challengerSongIds        String[]              // 1-10 song IDs from the challenger
  opponentSongIds          String[]              // populated on accept; same length
  proposedTheme            String?
  proposedTotalRounds      Int                   @default(10)
  proposedRoundDurationSec Int                   @default(180)
  proposedTier             String                @default("MAIN_EVENT")
  proposedStartsAt         DateTime
  status                   VerzuzChallengeStatus @default(PENDING)
  message                  String?               @db.Text
  createdAt                DateTime              @default(now())
  expiresAt                DateTime              // PENDING expires after 48h
  acceptedAt               DateTime?
  declinedAt               DateTime?
  matchId                  String?               @unique // VerzuzMatch row created on accept

  @@index([opponentId, status])
  @@index([challengerId, status])
  @@index([expiresAt])
}

enum VerzuzChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model VerzuzRound {
  id            String   @id @default(cuid())
  matchId       String
  match         VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  roundNumber   Int
  songAId       String
  songBId       String
  songA         Song     @relation("VerzuzRoundSongA", fields: [songAId], references: [id], onDelete: Cascade)
  songB         Song     @relation("VerzuzRoundSongB", fields: [songBId], references: [id], onDelete: Cascade)
  votesA        Int      @default(0)
  votesB        Int      @default(0)
  // Set when the round closes (timer expires or moderator advances).
  // Null while live; "A" / "B" / "TIE" when locked.
  winner        String?
  createdAt     DateTime @default(now())
  @@unique([matchId, roundNumber])
  @@index([matchId, roundNumber])
}

model VerzuzVote {
  id            String   @id @default(cuid())
  matchId       String
  match         VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  roundNumber   Int
  voterId       String
  voter         User     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  votedSongId   String
  createdAt     DateTime @default(now())
  // One vote per (match, round, voter). Voter can change their pick
  // until the round closes, but the unique constraint forces upsert.
  @@unique([matchId, roundNumber, voterId])
  @@index([matchId, roundNumber])
}

// ─────────────────────────────────────────
// PUSH NOTIFICATIONS
// ─────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Lightweight daily session ping from native app shell.
// Durable trail of authentication events (success + failure). PostHog gets the
// same events for product analytics, but those go away if POSTHOG_KEY isn't
// configured or the project is paused — this table is the always-on forensic
// log. Email is stored already-masked; never write a plaintext password or token.
model AuthEvent {
  id          String   @id @default(cuid())
  event       String   // matches AuthEventName union
  userId      String?
  emailMasked String?
  ipHash      String?  // SHA256 of IP, never the raw value
  userAgent   String?
  reason      String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Durable fraud/abuse event ledger. This is separate from product analytics so
// operators can investigate abuse even when third-party analytics are disabled.
model RiskEvent {
  id            String   @id @default(cuid())
  eventType     String   // suspicious_signup | fake_play | fake_vote | failed_payment | content_report
  severity      String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  status        String   @default("OPEN") // OPEN | DISMISSED | ESCALATED | ACTIONED
  actorUserId   String?
  targetUserId  String?
  songId        String?
  reportId      String?
  transactionId String?
  ipHash        String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?
  reviewedById  String?

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([status, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([songId, createdAt])
  @@index([createdAt])
}

// Tracks real-world version distribution + platform mix without a 3P SDK.
model NativeTelemetryEvent {
  id         String   @id @default(cuid())
  userId     String?  // null for unauthenticated sessions
  platform   String   // "ios" | "android"
  osVersion  String
  appVersion String
  appBuild   String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Guest shareable links — anonymous WAV uploads from /studio/try.
// Visitor makes a beat, hits "Get a shareable link," we upload the
// audio, mint a public token, and they get /share/[token] to text
// to a friend. The friend lands on a public page with the audio +
// a "Try EMS Studio yourself" CTA — that's the viral loop.
//
// 7-day TTL so the public bucket doesn't grow unbounded; a daily
// cron purges expired rows + their underlying audio files.
model GuestShare {
  id         String   @id @default(cuid())
  // Public, URL-safe token. Generated client/server-side as a 16-byte
  // base64url string. Indexed unique because /share/[token] hits this.
  token      String   @unique
  audioUrl   String
  fileName   String
  ipHash     String?  // for spam/rate-limit, not for tracking
  listenCount Int     @default(0)
  durationSec Int?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// PLAYLISTS
// User-curated collections of songs. Loose foreign keys (no Prisma
// relations) follow the SavedTrack pattern — keeps cascade behavior
// explicit at the application layer and avoids cross-domain coupling.
// ─────────────────────────────────────────

model Playlist {
  id          String   @id @default(cuid())
  ownerId     String
  name        String   @db.VarChar(120)
  description String?  @db.Text
  coverUrl    String?
  // When true, /playlists/[id] is reachable by anyone with the link
  // (used for share-by-link). When false, only the owner can view it.
  isPublic    Boolean  @default(false)
  // URL-safe public share token. Issued lazily on first share so we
  // don't leak ids; rotated when the owner clicks "regenerate link".
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([isPublic, updatedAt])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  songId     String
  // Manual ordering — front-end persists drag-to-reorder by writing
  // back position values. Float so we can insert between two rows
  // without renumbering the whole list.
  position   Float    @default(0)
  addedAt    DateTime @default(now())
  // Who added the track. Always equals the playlist owner today, but
  // tracked separately so collaborative playlists become a 1-column
  // change instead of a backfill.
  addedById  String

  @@unique([playlistId, songId])
  @@index([playlistId, position])
  @@index([songId])
}

// ─────────────────────────────────────────
// REDEEM CODES
// Admin-mintable codes that grant bonus song slots, PRO trial time,
// boost credits, or license-fee waivers. The reward shape is JSON
// so we can ship new reward types without a migration; the consume
// site validates the shape at runtime.
// ─────────────────────────────────────────

model RedeemCode {
  id          String   @id @default(cuid())
  // Human-typeable code (e.g. EMS-WELCOME-5K). Uppercased server-side
  // before lookup so case never matters. Unique so two batches never
  // collide.
  code        String   @unique
  // Reward payload validated at consume time. Shape:
  // { bonusSongSlots?: number, trialDays?: number,
  //   freeBoostCredits?: number, freeLicenseFeeWaivers?: number, note?: string }
  reward      Json
  // Optional cap on how many users can redeem. Null = unlimited (but
  // single-user codes still enforced by the unique on RedeemRedemption).
  maxUses     Int?
  uses        Int      @default(0)
  // Optional expiry. Past expiresAt, the code is dead even if it has
  // uses remaining.
  expiresAt   DateTime?
  // Free-form description for the admin dashboard ("Open mic giveaway",
  // "Reddit launch bundle"). Never shown to redeemers.
  description String?  @db.Text
  // Admin who minted this batch — useful when investigating abuse.
  createdById String
  createdAt   DateTime @default(now())
  // Soft-disable without deleting the row. Frozen codes return a
  // generic "this code is no longer active" error.
  frozenAt    DateTime?

  @@index([expiresAt])
  @@index([createdById, createdAt])
}

model RedeemRedemption {
  id        String   @id @default(cuid())
  codeId    String
  userId    String
  // Snapshot of the reward as granted, so downstream audits don't have
  // to re-resolve the parent RedeemCode (which an admin may have
  // edited or frozen since).
  reward    Json
  createdAt DateTime @default(now())

  // Each user can redeem a given code at most once. Stops re-runs from
  // double-granting when a network blip causes the client to retry.
  @@unique([codeId, userId])
  @@index([userId, createdAt])
}
