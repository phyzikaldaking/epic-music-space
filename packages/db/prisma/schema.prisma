// ─────────────────────────────────────────────────────────────
// Revenue share + payout ledger
// ─────────────────────────────────────────────────────────────

model RevenueEvent {
  id           String           @id @default(cuid())
  type         RevenueEventType
  // Source pointers — at most one filled in (denormalized for fast filtering).
  songId       String?
  song         Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)
  transactionId String?         @unique
  transaction  Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  adPlacementId String?
  adPlacement   AdPlacement?    @relation("AdPlacementRevenue", fields: [adPlacementId], references: [id], onDelete: SetNull)
  grossCents   Int              // gross revenue in cents (USD)
  feeCents     Int              @default(0)  // Stripe / processor fees
  currency     String           @default("usd")
  occurredAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  splits       RevenueSplit[]

  @@index([type, occurredAt])
  @@index([songId, occurredAt])
}

enum RevenueEventType {
  LICENSE_SALE
  TIP
  AD_PURCHASE
  STREAM_ROYALTY
  AUCTION_WIN
  BOOST
  SUBSCRIPTION
  SERVICE_SALE
  REFUND        // negative gross — clawback
}

model RevenueSplit {
  id        String           @id @default(cuid())
  eventId   String
  event     RevenueEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("RevenueSplits", fields: [userId], references: [id], onDelete: Cascade)
  role      RevenueSplitRole
  amountCents Int            // can be negative for clawbacks
  status    RevenueSplitStatus @default(PENDING)
  payoutId  String?
  payout    Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  paidAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status])
  @@index([eventId])
  @@index([payoutId])
}

enum RevenueSplitRole {
  ARTIST
  HOLDER
  LABEL
  PLATFORM
  HOST          // listening-session host
}

enum RevenueSplitStatus {
  PENDING       // accrued, not yet paid
  PAID          // included in a Payout that succeeded
  CLAWED_BACK   // refund/dispute reversed it
  EXCLUDED      // platform fee, not actually paid out
}

// SplitSheet — the agreement among collaborators about how royalties
// for a song will be divided. Generated automatically at publish time
// by snapshotting the active studio session's collaborators (everyone
// who was present when the artist hit publish), defaulted to equal
// shares. The artist can override before signing. Once status=SIGNED
// the platform uses these shares to allocate RevenueSplit rows on
// each payout. status=DRAFT means the shares are still editable.
model SplitSheet {
  id        String          @id @default(cuid())
  songId    String          @unique
  song      Song            @relation(fields: [songId], references: [id], onDelete: Cascade)
  status    SplitSheetStatus @default(DRAFT)
  // Captured at the moment the artist published, so the split sheet
  // tells a fair story even if the artist later removes a collaborator
  // from their network.
  createdFromSessionId String?
  signedAt  DateTime?
  entries   SplitSheetEntry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
}

model SplitSheetEntry {
  id            String     @id @default(cuid())
  sheetId       String
  sheet         SplitSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  // userId is null when the entry represents a collaborator who was
  // present in the session but isn't a registered EMS user yet (a
  // friend invited via link). They get an invite to claim the share.
  userId        String?
  user          User?      @relation("SplitSheetEntries", fields: [userId], references: [id], onDelete: SetNull)
  displayName   String     // captured at publish so the row is readable even if user is null
  role          SplitSheetRole @default(WRITER)
  // Share in basis points (10000 = 100%). Sum across entries should
  // equal 10000; the UI enforces this before SIGNED.
  shareBps      Int
  inviteEmail   String?    // for non-user entries — the invite link goes here
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([sheetId])
  @@index([userId])
}

enum SplitSheetStatus {
  DRAFT      // editable; not yet binding
  SIGNED     // locked; revenue splits flow off this sheet
  ARCHIVED   // superseded by a newer signed sheet (kept for audit)
}

enum SplitSheetRole {
  ARTIST     // primary creator (default 100% if no collaborators)
  WRITER     // co-writer
  PRODUCER   // beat / production
  ENGINEER   // mix / master
  FEATURE    // featured performer
}

enum AdLocation {
  MARKETPLACE_BANNER
  STUDIO_SIDEBAR
  CITY_BILLBOARD
  VERSUS_BANNER
}

model Notification {
