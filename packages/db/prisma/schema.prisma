// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  username         String?          @unique
  image            String?
  passwordHash     String?
  role             Role             @default(LISTENER)
  subscriptionTier SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  emailVerified    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  trialExpiresAt   DateTime?
  stripeConnectId  String?          @unique

  // ── Identity / verification ────────────────────────────────
  // Verified-artist badge. Set by an admin via /api/admin/users/[id]/verify.
  isVerified         Boolean  @default(false)
  verifiedAt         DateTime?

  // ── Stripe Connect compliance ──────────────────────────────
  connectChargesEnabled Boolean  @default(false)
  connectPayoutsEnabled Boolean  @default(false)
  connectRequirements   Json?    // Stripe requirements object (currently_due, errors, etc.)
  connectCountry        String?  // ISO 3166-1 alpha-2 from Stripe account

  // ── Tax compliance ─────────────────────────────────────────
  taxFormStatus TaxFormStatus @default(NOT_COLLECTED)
  taxIdType     String?       // e.g. "us_ein", "us_ssn", "gb_vat", "eu_vat"

  accounts Account[]
  sessions Session[]
  songs        Song[]
  licenses     LicenseToken[]
  transactions Transaction[]
  payouts      Payout[]
  studio           Studio?
  ownedLabel       Label?         @relation("LabelOwner")
  labelMemberships LabelArtist[]  @relation("LabelArtistUser")
  adPlacements     AdPlacement[]
  notifications    Notification[]
  versusVotes      VersusVote[]
  battlesCreated   BattleRoyale[]     @relation("BattleRoyaleCreator")
  royaleVotes      BattleRoyaleVote[] @relation("BattleRoyaleVotes")
  following        UserFollow[]   @relation("Follower")
  followers        UserFollow[]   @relation("Following")
  inviteCodesCreated InviteCode[] @relation("InviteCreator")
  inviteCodeUsed     InviteCode?  @relation("InviteUsed")
  badges UserBadge[]
  auctionsCreated Auction[]    @relation("AuctionSeller")
  auctionsWon     Auction[]    @relation("AuctionWinner")
  auctionBids     AuctionBid[] @relation("AuctionBidder")
  behaviorEvents  UserBehaviorEvent[]
  tasteProfile    UserTasteProfile?
  roomsHosted        Room[]              @relation("RoomHost")
  roomParticipations RoomParticipant[]
  roomMessages       RoomMessage[]
  roomBans           RoomBan[]           @relation("RoomBanned")
  roomBansIssued     RoomBan[]           @relation("RoomBannedBy")
  revenueSplits      RevenueSplit[]      @relation("RevenueSplits")
  serviceListings    ServiceListing[]    @relation("ServiceProvider")
  serviceOrdersAsBuyer    ServiceOrder[] @relation("ServiceBuyer")
  serviceOrdersAsProvider ServiceOrder[] @relation("ServiceProviderOrders")
  serviceMessages    ServiceOrderMessage[] @relation("ServiceMessageAuthor")
  serviceReviews     ServiceReview[]    @relation("ServiceReviewer")
  posts              Post[]             @relation("PostAuthor")
  postComments       PostComment[]      @relation("PostCommentAuthor")
  postLikes          PostLike[]         @relation("PostLikeUser")
  connectedAccounts  ConnectedAccount[]
  blocking           UserBlock[]        @relation("Blocker")
  blockedBy          UserBlock[]        @relation("Blocked")
  reportsFiled       UserReport[]       @relation("Reporter")
  reportsReceived    UserReport[]       @relation("Reported")
  notifPrefs         NotificationPreference[]
}

enum Role {
  LISTENER
  ARTIST
  PRODUCER
  ENGINEER
  LABEL
  ADMIN
}

enum TaxFormStatus {
  NOT_COLLECTED
  PENDING
  COLLECTED
  EXEMPT
}

enum SubscriptionTier {
  FREE
  TRIAL
  STARTER
  PRO
  PRIME
  TEAM
  LABEL_TIER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

// Connected third-party social accounts that can be used to post on behalf
// of a user. Tokens are stored encrypted in the application DB.
model ConnectedAccount {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  providerAccountId  String
  accessToken        String?  @db.Text
  refreshToken       String?  @db.Text
  expiresAt          Int?
  scope              String?
  meta               Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique  // sha256 of the raw token; raw value is only emailed
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expires])
}

model Song {
  id          String  @id @default(cuid())
  title       String
  artist      String
  genre       String?
  description String? @db.Text
  audioUrl    String
  coverUrl    String?
  bpm         Int?
  key         String?
  licensePrice    Decimal @db.Decimal(10, 2)
  revenueSharePct Decimal @db.Decimal(5, 2)
  totalLicenses   Int     @default(100)
  soldLicenses    Int     @default(0)
  isActive        Boolean @default(true)
  aiScore      Float    @default(0)
  boostScore   Float    @default(0)
  versusWins   Int      @default(0)
  versusLosses Int      @default(0)
  streamCount  Int      @default(0)
  district     District @default(INDIE_BLOCKS)
  stemUrl   String?
  stemFiles Json?
  hasStems  Boolean @default(false)
  // When false (default), the audio file is preview-only. Listeners can stream
  // through the proxy but cannot download the underlying file. License
  // purchase or artist opt-in (true) is required for download.
  allowFreeDownload Boolean @default(false)
  // Legacy / vault tracks: older catalog material (e.g. "back when I used to
  // rap"). Rendered in a separate Legacy section on /studio/[username] and
  // excluded from /trending + /marketplace defaults so the new-releases
  // surface stays current.
  isLegacy            Boolean @default(false)
  originalReleaseYear Int?    // optional context for legacy tracks (e.g. 2003)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artistId String
  artist_  User   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  licenses       LicenseToken[]
  transactions   Transaction[]
  payouts        Payout[]
  versusMatchesA VersusMatch[]       @relation("VersusA")
  versusMatchesB VersusMatch[]       @relation("VersusB")
  royaleEntries  BattleRoyaleEntry[] @relation("BattleRoyaleEntries")
  auctions       Auction[]
  behaviorEvents UserBehaviorEvent[]
  rooms          Room[]
  revenueEvents  RevenueEvent[]
  @@index([artistId])
  @@index([district])
  @@index([isActive])
  @@index([aiScore])
  @@index([isActive, aiScore, createdAt])
}

model LicenseToken {
  id          String        @id @default(cuid())
  tokenNumber Int
  status      LicenseStatus @default(ACTIVE)
  purchasedAt DateTime      @default(now())
  price       Decimal       @db.Decimal(10, 2)
  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  holderId String
  holder   User   @relation(fields: [holderId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payouts      Payout[]
  @@unique([songId, tokenNumber])
  @@index([holderId])
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Transaction {
  id       String          @id @default(cuid())
  amount   Decimal         @db.Decimal(10, 2)
  currency String          @default("usd")
  type     TransactionType
  status   PaymentStatus   @default(PENDING)
  stripePaymentIntentId String? @unique
  stripeSessionId       String? @unique
  metadata              Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String?
  song   Song?   @relation(fields: [songId], references: [id])
  licenseTokenId String?
  licenseToken   LicenseToken? @relation(fields: [licenseTokenId], references: [id])
  revenueEvent   RevenueEvent?
  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([songId, status])
}

enum TransactionType {
  LICENSE_PURCHASE
  REVENUE_PAYOUT
  SUBSCRIPTION
  BOOST
  TIP
  AUCTION_WIN
  SERVICE_PURCHASE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payout {
  id        String       @id @default(cuid())
  amount    Decimal      @db.Decimal(10, 2)
  currency  String       @default("usd")
  period    String
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String?
  song   Song?   @relation(fields: [songId], references: [id])
  licenseTokenId String?
  licenseToken   LicenseToken? @relation(fields: [licenseTokenId], references: [id])
  splits         RevenueSplit[]
  stripeTransferId String?    @unique
  failures       PayoutFailure[]
  @@unique([userId, period])
  @@index([userId])
  @@index([status])
  @@index([period])
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  source      String   // "stripe" | "livekit" | etc
  eventId     String
  processedAt DateTime @default(now())

  @@unique([source, eventId])
  @@index([processedAt])
}

model PayoutFailure {
  id        String   @id @default(cuid())
  userId    String
  payoutId  String?
  payout    Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  period    String
  amountCents Int
  reason    String   @db.Text
  retried   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([period])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum District {
  INDIE_BLOCKS
  DOWNTOWN_PRIME
  LABEL_ROW
}

model Studio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  bio         String?  @db.Text
  district    District @default(INDIE_BLOCKS)
  level       Int      @default(1)
  bannerUrl   String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VersusMatch {
  id        String       @id @default(cuid())
  songAId   String
  songBId   String
  songA     Song         @relation("VersusA", fields: [songAId], references: [id], onDelete: Cascade)
  songB     Song         @relation("VersusB", fields: [songBId], references: [id], onDelete: Cascade)
  votesA    Int          @default(0)
  votesB    Int          @default(0)
  status    VersusStatus @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime     @default(now())
  votes VersusVote[]
  @@index([status])
  @@index([endsAt])
  @@index([songAId])
  @@index([songBId])
}

enum VersusStatus {
  ACTIVE
  COMPLETED
}

model VersusVote {
  id          String      @id @default(cuid())
  matchId     String
  match       VersusMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  votedSongId String
  createdAt DateTime @default(now())
  @@unique([matchId, userId])
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  ownerId     String   @unique
  owner       User     @relation("LabelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  logoUrl     String?
  bio         String?  @db.Text
  revSharePct Decimal  @default(10) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artists LabelArtist[]
}

model LabelArtist {
  id          String            @id @default(cuid())
  labelId     String
  label       Label             @relation(fields: [labelId], references: [id], onDelete: Cascade)
  artistId    String
  artist      User              @relation("LabelArtistUser", fields: [artistId], references: [id], onDelete: Cascade)
  revSharePct Decimal           @db.Decimal(5, 2)
  status      LabelArtistStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  @@unique([labelId, artistId])
}

enum LabelArtistStatus {
  PENDING
  ACTIVE
  TERMINATED
}

model AdPlacement {
  id        String     @id @default(cuid())
  location  AdLocation
  title     String
  mediaUrl  String
  linkUrl   String?
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  price     Decimal    @db.Decimal(10, 2)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  impressions AdImpression[]
  clicks      AdClick[]
  revenueEvents RevenueEvent[] @relation("AdPlacementRevenue")

  @@index([location, isActive, startDate, endDate])
  @@index([ownerId])
}

model AdImpression {
  id          String   @id @default(cuid())
  placementId String
  placement   AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  userId      String?
  sessionId   String?      // anonymous client UUID stored in localStorage
  ipHash      String?      // sha256(ip + daily salt) — privacy-preserving fraud guard
  userAgent   String?      @db.Text
  referrer    String?      @db.Text
  createdAt   DateTime     @default(now())

  @@index([placementId, createdAt])
  @@index([userId, createdAt])
  @@index([ipHash, placementId, createdAt])
}

model AdClick {
  id          String   @id @default(cuid())
  placementId String
  placement   AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  userId      String?
  sessionId   String?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([placementId, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Revenue share + payout ledger
// ─────────────────────────────────────────────────────────────

model RevenueEvent {
  id           String           @id @default(cuid())
  type         RevenueEventType
  // Source pointers — at most one filled in (denormalized for fast filtering).
  songId       String?
  song         Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)
  transactionId String?         @unique
  transaction  Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  adPlacementId String?
  adPlacement   AdPlacement?    @relation("AdPlacementRevenue", fields: [adPlacementId], references: [id], onDelete: SetNull)
  grossCents   Int              // gross revenue in cents (USD)
  feeCents     Int              @default(0)  // Stripe / processor fees
  currency     String           @default("usd")
  occurredAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  splits       RevenueSplit[]

  @@index([type, occurredAt])
  @@index([songId, occurredAt])
}

enum RevenueEventType {
  LICENSE_SALE
  TIP
  AD_PURCHASE
  STREAM_ROYALTY
  AUCTION_WIN
  BOOST
  SUBSCRIPTION
  SERVICE_SALE
  REFUND        // negative gross — clawback
}

model RevenueSplit {
  id        String           @id @default(cuid())
  eventId   String
  event     RevenueEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("RevenueSplits", fields: [userId], references: [id], onDelete: Cascade)
  role      RevenueSplitRole
  amountCents Int            // can be negative for clawbacks
  status    RevenueSplitStatus @default(PENDING)
  payoutId  String?
  payout    Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  paidAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status])
  @@index([eventId])
  @@index([payoutId])
}

enum RevenueSplitRole {
  ARTIST
  HOLDER
  LABEL
  PLATFORM
  HOST          // listening-session host
}

enum RevenueSplitStatus {
  PENDING       // accrued, not yet paid
  PAID          // included in a Payout that succeeded
  CLAWED_BACK   // refund/dispute reversed it
  EXCLUDED      // platform fee, not actually paid out
}

enum AdLocation {
  MARKETPLACE_BANNER
  STUDIO_SIDEBAR
  CITY_BILLBOARD
  VERSUS_BANNER
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([userId, read])
  @@index([userId, createdAt])
}

// Per-user, per-type notification preferences. Missing rows default to
// "enabled" so the UI only needs to write when a user opts out.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // POST_LIKED | POST_COMMENTED | FOLLOWED_POST | FOLLOW | LICENSE_SOLD | …
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([userId, type])
  @@index([userId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
}

// One user blocking another. When A blocks B, B's posts are filtered out
// of A's feed and B can't comment on or like A's posts. Mute is similar
// but only hides — it doesn't prevent B's interactions.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// User-submitted moderation report — feeds the admin queue.
model UserReport {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  // The thing being reported. Exactly one of (reportedUserId, postId) is set.
  reportedUserId String?
  reportedUser   User?  @relation("Reported", fields: [reportedUserId], references: [id], onDelete: SetNull)
  postId      String?
  reason      String   // "SPAM" | "ABUSE" | "IMPERSONATION" | "NSFW" | "OTHER"
  details     String?  @db.Text
  status      String   @default("PENDING") // PENDING | REVIEWED | DISMISSED | ACTIONED
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([postId])
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedById String? @unique
  usedBy   User?   @relation("InviteUsed", fields: [usedById], references: [id])
}

model UserBadge {
  id        String    @id @default(cuid())
  type      BadgeType
  awardedAt DateTime  @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type])
}

enum BadgeType {
  EARLY_ADOPTER
  INVITE_5
  INVITE_10
  INVITE_50
  FIRST_BATTLE_WIN
  FIRST_LICENSE_SOLD
  LICENSE_HOLDER
  TOP_ARTIST
}

model Auction {
  id       String @id @default(cuid())
  songId   String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  sellerId String
  seller   User   @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  startingBid  Decimal  @db.Decimal(10, 2)
  reservePrice Decimal? @db.Decimal(10, 2)
  currentBid   Decimal? @db.Decimal(10, 2)
  winnerId String?
  winner   User?   @relation("AuctionWinner", fields: [winnerId], references: [id])
  status    AuctionStatus @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bids AuctionBid[]
  @@index([status, endsAt])
  @@index([songId])
  @@index([sellerId])
  @@index([sellerId, status])
}

enum AuctionStatus {
  ACTIVE
  ENDED
  SETTLED
  EXPIRED
  CANCELLED
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation("AuctionBidder", fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  @@index([auctionId, amount(sort: Desc)])
  @@index([bidderId])
}

model BattleRoyale {
  id        String              @id @default(cuid())
  creatorId String
  creator   User                @relation("BattleRoyaleCreator", fields: [creatorId], references: [id])
  status    VersusStatus        @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime            @default(now())
  entries   BattleRoyaleEntry[]
  votes     BattleRoyaleVote[]
  @@index([status])
  @@index([endsAt])
}

model BattleRoyaleEntry {
  id       String       @id @default(cuid())
  battleId String
  battle   BattleRoyale @relation(fields: [battleId], references: [id], onDelete: Cascade)
  songId   String
  song     Song         @relation("BattleRoyaleEntries", fields: [songId], references: [id], onDelete: Cascade)
  votes    Int          @default(0)
  position Int
}

model BattleRoyaleVote {
  id        String       @id @default(cuid())
  battleId  String
  battle    BattleRoyale @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("BattleRoyaleVotes", fields: [userId], references: [id], onDelete: Cascade)
  songId    String
  createdAt DateTime     @default(now())
  @@unique([battleId, userId])
  @@index([battleId])
}

model DominanceHistory {
  id        String   @id @default(cuid())
  songId    String
  songTitle String
  artistId  String
  artist    String
  rank      Int
  power     Float    @default(0)
  eventType DominanceEventType
  startedAt DateTime @default(now())
  endedAt   DateTime?
  metadata  Json?
  @@index([songId, startedAt])
  @@index([artistId, startedAt])
  @@index([rank, startedAt])
}

model ArtistDominanceStats {
  id               String   @id @default(cuid())
  artistId         String   @unique
  artist           String
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  totalWins        Int      @default(0)
  totalCrownHours  Float    @default(0)
  lastCrownedAt    DateTime?
  lastLostCrownAt  DateTime?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  @@index([totalWins])
  @@index([currentStreak])
}

model RankedSeason {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      SeasonStatus @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  resetBoosts Boolean      @default(false)
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  standings   SeasonStanding[]
  rewards     SeasonReward[]
  ceremonies  SeasonResetCeremony[]
  @@index([status, startsAt, endsAt])
}

model SeasonStanding {
  id              String     @id @default(cuid())
  seasonId        String
  season          RankedSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  artistId        String
  artist          String
  songId          String?
  songTitle       String?
  league          LeagueTier @default(BRONZE)
  points          Float      @default(0)
  peakRank        Int?
  currentRank     Int?
  crownWins       Int        @default(0)
  longestStreak   Int        @default(0)
  crownHours      Float      @default(0)
  promotionLocked Boolean    @default(false)
  updatedAt       DateTime   @updatedAt
  createdAt       DateTime   @default(now())
  @@unique([seasonId, artistId])
  @@index([seasonId, points])
  @@index([seasonId, league, points])
}

model SeasonReward {
  id          String       @id @default(cuid())
  seasonId    String
  season      RankedSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  artistId    String
  artist      String
  rank        Int
  league      LeagueTier
  rewardType  RewardType
  title       String
  description String
  value       Decimal?     @db.Decimal(10, 2)
  status      RewardStatus @default(PENDING)
  issuedAt    DateTime?
  createdAt   DateTime     @default(now())
  metadata    Json?
  @@index([seasonId, rank])
  @@index([artistId, status])
}

model SeasonResetCeremony {
  id              String         @id @default(cuid())
  seasonId        String
  season          RankedSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  status          CeremonyStatus @default(SCHEDULED)
  winnerArtistId  String?
  winnerArtist    String?
  winnerSongId    String?
  winnerSongTitle String?
  headline        String
  startsAt        DateTime
  completedAt     DateTime?
  nextSeasonSlug  String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  @@index([seasonId, status])
  @@index([startsAt])
}

enum SeasonStatus {
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  CROWN
}

enum RewardType {
  CASH
  BOOST_CREDITS
  FREE_PLACEMENT
  BADGE
  FEATURED_SLOT
}

enum RewardStatus {
  PENDING
  ISSUED
  CLAIMED
  EXPIRED
}

enum CeremonyStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum DominanceEventType {
  CROWN_WON
  CROWN_LOST
  RANK_GAINED
  RANK_LOST
  BOOST_APPLIED
  PLACEMENT_WON
}

// ── Personalization / Viral Feed ─────────────────────────────────────────────

enum BehaviorEventType {
  view
  watch_75
  like
  share
  skip
  view_track
}

model UserBehaviorEvent {
  id          String            @id @default(cuid())
  userId      String
  clipId      String
  songId      String?
  artist      String?
  eventType   BehaviorEventType
  value       Float             @default(0)
  metadata    Json?
  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  song        Song?             @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([clipId, eventType])
  @@index([songId, eventType])
}

model UserTasteProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  artistAffinity    Json     @default("{}")
  songAffinity      Json     @default("{}")
  eventAffinity     Json     @default("{}")
  skipSignals       Json     @default("{}")
  lastCalculatedAt  DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Listening sessions (live audio rooms via LiveKit)
// ─────────────────────────────────────────────────────────────

model Room {
  id            String     @id @default(cuid())
  hostId        String
  title         String
  description   String?    @db.Text
  status        RoomStatus @default(LIVE)
  maxCapacity   Int        // resolved at create time from host's tier
  currentSongId String?    // optional: track currently playing
  startedAt     DateTime   @default(now())
  endedAt       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  host          User              @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  currentSong   Song?             @relation(fields: [currentSongId], references: [id], onDelete: SetNull)
  participants  RoomParticipant[]
  messages      RoomMessage[]
  recordings    RoomRecording[]
  bans          RoomBan[]

  @@index([status, startedAt])
  @@index([hostId, status])
}

model RoomRecording {
  id              String           @id @default(cuid())
  roomId          String
  egressId        String?          @unique
  status          RecordingStatus  @default(PENDING)
  playbackUrl     String?
  durationSeconds Int?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  failureReason   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  room            Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
}

enum RecordingStatus {
  PENDING
  RECORDING
  READY
  FAILED
}

model RoomBan {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  bannedById  String
  reason      String?
  createdAt   DateTime @default(now())

  room        Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User @relation("RoomBanned", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy    User @relation("RoomBannedBy", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

enum RoomStatus {
  LIVE
  ENDED
}

model RoomParticipant {
  id        String                @id @default(cuid())
  roomId    String
  userId    String
  role      RoomParticipantRole   @default(LISTENER)
  handRaised Boolean              @default(false)
  joinedAt  DateTime              @default(now())
  leftAt    DateTime?

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, role])
}

enum RoomParticipantRole {
  HOST
  SPEAKER   // host has granted the floor; can publish audio
  LISTENER
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Services marketplace — engineers offer mix/master, producers sell
// templates / beats / sample packs. Listings are bookable; an order
// is paid via Stripe and a Transaction + RevenueEvent is recorded.
// ─────────────────────────────────────────────────────────────

model ServiceListing {
  id            String              @id @default(cuid())
  providerId    String
  provider      User                @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Cascade)
  kind          ServiceListingKind
  title         String
  description   String              @db.Text
  priceUsd      Decimal             @db.Decimal(10, 2)
  deliveryDays  Int                 @default(7)
  exampleAudioUrl String?
  coverUrl      String?
  // For non-bespoke goods (templates / beats / kits): instant download.
  // Set when kind is template/beat/kit. URL surfaced after purchase.
  downloadUrl   String?             @db.Text
  status        ServiceListingStatus @default(LIVE)
  totalSold     Int                 @default(0)
  rating        Float?
  ratingCount   Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  orders        ServiceOrder[]
  reviews       ServiceReview[]

  @@index([status, kind, createdAt])
  @@index([providerId, status])
}

enum ServiceListingKind {
  MIX                 // engineer service
  MASTER              // engineer service
  MIX_MASTER_BUNDLE   // engineer service
  PRODUCER_TEMPLATE   // FL/Logic/Ableton project file
  BEAT                // producer-made beat license
  DRUM_KIT
  SAMPLE_PACK
  LESSON              // 1:1 session
}

enum ServiceListingStatus {
  LIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

model ServiceOrder {
  id           String             @id @default(cuid())
  listingId    String
  listing      ServiceListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User               @relation("ServiceBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  providerId   String
  provider     User               @relation("ServiceProviderOrders", fields: [providerId], references: [id], onDelete: Cascade)
  priceUsd     Decimal            @db.Decimal(10, 2)
  status       ServiceOrderStatus @default(PENDING)
  briefText    String?            @db.Text  // buyer's notes (BPM, key, references, etc.)
  briefUrl     String?            @db.Text  // upload link for stems
  deliverableUrl String?          @db.Text  // provider's final delivery
  deliveredAt  DateTime?
  completedAt  DateTime?                    // buyer accepted (or auto-accepted)
  acceptDeadline DateTime?                  // 14 days after deliveredAt
  revisionsUsed Int               @default(0)
  stripeSessionId      String?    @unique
  stripePaymentIntentId String?   @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages     ServiceOrderMessage[]
  revisions    ServiceOrderRevision[]
  review       ServiceReview?

  @@index([buyerId, status])
  @@index([providerId, status])
  @@index([listingId, status])
  @@index([status, acceptDeadline])
}

model ServiceOrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser  User     @relation("ServiceMessageAuthor", fields: [fromUserId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  attachmentUrl String? @db.Text
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ServiceOrderRevision {
  id        String   @id @default(cuid())
  orderId   String
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revisionNumber Int           // 1 = first delivery, 2 = first revision, ...
  deliverableUrl String  @db.Text
  message   String?  @db.Text
  deliveredAt DateTime @default(now())

  @@unique([orderId, revisionNumber])
  @@index([orderId])
}

model ServiceReview {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId   String
  listing     ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("ServiceReviewer", fields: [buyerId], references: [id], onDelete: Cascade)
  providerId  String
  rating      Int      // 1..5
  body        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([providerId, createdAt])
}

enum ServiceOrderStatus {
  PENDING               // checkout started, payment not confirmed
  PAID                  // payment received, awaiting provider work
  IN_PROGRESS           // provider acknowledged or revising
  DELIVERED             // deliverableUrl set, awaiting buyer review
  REVISION_REQUESTED    // buyer asked for changes
  COMPLETED             // buyer accepted (or auto-accepted) — payout finalized
  REFUNDED              // refunded via Stripe
  CANCELLED             // either side cancelled before delivery
}

// ─────────────────────────────────────────
// USER TIMELINE / POSTS
// ─────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  // Optional song attachment (artists posting about a track)
  songId    String?
  // Media — at most one block per post (handled in app code)
  imageUrl  String?
  // Mux video — populated by webhook when asset is ready
  muxUploadId  String?  @unique
  muxAssetId   String?  @unique
  muxPlaybackId String? @unique
  videoStatus  PostVideoStatus @default(NONE)
  videoDurationSec Int?
  videoAspectRatio String?
  isPublished Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  PostComment[]
  likes     PostLike[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([videoStatus])
}

enum PostVideoStatus {
  NONE
  UPLOADING   // direct upload created, file in transit / awaiting Mux pickup
  PROCESSING  // Mux is encoding
  READY       // playable
  FAILED
}

model PostComment {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User     @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body     String   @db.Text
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model PostLike {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// ─────────────────────────────────────────
// ADMIN AUDIT LOG
// ─────────────────────────────────────────

model AdminActionLog {
  id        String   @id @default(cuid())
  adminId   String   // user id of the admin who took the action
  adminEmail String? // snapshot, in case the admin user is later deleted
  action    String   // e.g. "song.delete", "auction.cancel", "user.role_change"
  target    String?  // resource id targeted (songId, auctionId, userId, etc.)
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([target])
}

// ─────────────────────────────────────────
// EMAIL DRIP SEQUENCE TRACKING
// ─────────────────────────────────────────

model EmailDripSent {
  id        String   @id @default(cuid())
  userId    String
  step      String   // "welcome_day_0", "tips_day_1", "payout_day_3"
  sentAt    DateTime @default(now())

  @@unique([userId, step])
  @@index([sentAt])
}

// ─────────────────────────────────────────
// STATUS PAGE INCIDENTS
// ─────────────────────────────────────────

model StatusIncident {
  id          String        @id @default(cuid())
  title       String
  body        String?       @db.Text
  severity    IncidentSeverity @default(INVESTIGATING)
  resolvedAt  DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([resolvedAt])
  @@index([createdAt])
}

enum IncidentSeverity {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

// ─────────────────────────────────────────
// SUPPORT TICKETS
// ─────────────────────────────────────────

model SupportTicket {
  id           String   @id @default(cuid())
  ticketCode   String   @unique // human-friendly e.g. "EMS-7H3K"
  email        String
  name         String?
  subject      String
  body         String   @db.Text
  userId       String?  // null when sender isn't logged in
  status       SupportTicketStatus @default(OPEN)
  ip           String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum SupportTicketStatus {
  OPEN
  REPLIED
  RESOLVED
  SPAM
}

// ─────────────────────────────────────────
// SAVED TRACKS (wishlist / liked but not licensed)
// ─────────────────────────────────────────

model SavedTrack {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  @@unique([userId, songId])
  @@index([userId, createdAt])
  @@index([songId])
}

// ─────────────────────────────────────────
// VERSUS CHALLENGES (cross-artist consent flow)
// ─────────────────────────────────────────

model VersusChallenge {
  id              String    @id @default(cuid())
  challengerId    String    // user.id of the artist who initiated
  challengerSongId String   // song.id they're putting up
  opponentId      String    // user.id of the artist being challenged
  opponentSongId  String?   // song.id the opponent picks on accept
  status          VersusChallengeStatus @default(PENDING)
  message         String?   @db.Text
  durationHours   Int       @default(24)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime  // PENDING expires after 48h
  acceptedAt      DateTime?
  declinedAt      DateTime?
  matchId         String?   @unique // populated once the resulting VersusMatch is created

  @@index([opponentId, status])
  @@index([challengerId, status])
  @@index([expiresAt])
}

enum VersusChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────
// VERSUS TIPS (tip-with-vote)
// ─────────────────────────────────────────

model VersusTip {
  id              String   @id @default(cuid())
  matchId         String
  voterId         String
  votedSongId     String
  amountUsd       Decimal  @db.Decimal(10, 2)
  status          VersusTipStatus @default(PENDING)
  stripeSessionId String?  @unique
  stripePaymentIntentId String? @unique
  createdAt       DateTime @default(now())
  paidAt          DateTime?

  @@index([matchId])
  @@index([voterId])
  @@index([status])
}

enum VersusTipStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
