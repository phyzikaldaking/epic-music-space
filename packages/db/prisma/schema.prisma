// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  username         String?          @unique
  image            String?
  passwordHash     String?
  role             Role             @default(LISTENER)
  subscriptionTier SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  emailVerified    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  trialExpiresAt   DateTime?
  stripeConnectId  String?          @unique

  accounts Account[]
  sessions Session[]
  songs        Song[]
  licenses     LicenseToken[]
  transactions Transaction[]
  payouts      Payout[]
  studio           Studio?
  ownedLabel       Label?         @relation("LabelOwner")
  labelMemberships LabelArtist[]  @relation("LabelArtistUser")
  adPlacements     AdPlacement[]
  notifications    Notification[]
  versusVotes      VersusVote[]
  battlesCreated   BattleRoyale[]     @relation("BattleRoyaleCreator")
  royaleVotes      BattleRoyaleVote[] @relation("BattleRoyaleVotes")
  following        UserFollow[]   @relation("Follower")
  followers        UserFollow[]   @relation("Following")
  inviteCodesCreated InviteCode[] @relation("InviteCreator")
  inviteCodeUsed     InviteCode?  @relation("InviteUsed")
  badges UserBadge[]
  auctionsCreated Auction[]    @relation("AuctionSeller")
  auctionsWon     Auction[]    @relation("AuctionWinner")
  auctionBids     AuctionBid[] @relation("AuctionBidder")
}

enum Role {
  LISTENER
  ARTIST
  LABEL
  ADMIN
}

enum SubscriptionTier {
  FREE
  TRIAL
  STARTER
  PRO
  PRIME
  TEAM
  LABEL_TIER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Song {
  id          String  @id @default(cuid())
  title       String
  artist      String
  genre       String?
  description String? @db.Text
  audioUrl    String
  coverUrl    String?
  bpm         Int?
  key         String?
  licensePrice    Decimal @db.Decimal(10, 2)
  revenueSharePct Decimal @db.Decimal(5, 2)
  totalLicenses   Int     @default(100)
  soldLicenses    Int     @default(0)
  isActive        Boolean @default(true)
  aiScore      Float    @default(0)
  boostScore   Float    @default(0)
  versusWins   Int      @default(0)
  versusLosses Int      @default(0)
  streamCount  Int      @default(0)
  district     District @default(INDIE_BLOCKS)
  stemUrl   String?
  stemFiles Json?
  hasStems  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artistId String
  artist_  User   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  licenses       LicenseToken[]
  transactions   Transaction[]
  payouts        Payout[]
  versusMatchesA VersusMatch[]       @relation("VersusA")
  versusMatchesB VersusMatch[]       @relation("VersusB")
  royaleEntries  BattleRoyaleEntry[] @relation("BattleRoyaleEntries")
  auctions       Auction[]
  @@index([artistId])
  @@index([district])
  @@index([isActive])
  @@index([aiScore])
  @@index([isActive, aiScore, createdAt])
}

model LicenseToken {
  id          String        @id @default(cuid())
  tokenNumber Int
  status      LicenseStatus @default(ACTIVE)
  purchasedAt DateTime      @default(now())
  price       Decimal       @db.Decimal(10, 2)
  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  holderId String
  holder   User   @relation(fields: [holderId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payouts      Payout[]
  @@unique([songId, tokenNumber])
  @@index([holderId])
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Transaction {
  id       String          @id @default(cuid())
  amount   Decimal         @db.Decimal(10, 2)
  currency String          @default("usd")
  type     TransactionType
  status   PaymentStatus   @default(PENDING)
  stripePaymentIntentId String? @unique
  stripeSessionId       String? @unique
  metadata              Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String?
  song   Song?   @relation(fields: [songId], references: [id])
  licenseTokenId String?
  licenseToken   LicenseToken? @relation(fields: [licenseTokenId], references: [id])
  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([songId, status])
}

enum TransactionType {
  LICENSE_PURCHASE
  REVENUE_PAYOUT
  SUBSCRIPTION
  BOOST
  TIP
  AUCTION_WIN
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payout {
  id        String       @id @default(cuid())
  amount    Decimal      @db.Decimal(10, 2)
  currency  String       @default("usd")
  period    String
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String
  song   Song   @relation(fields: [songId], references: [id])
  licenseTokenId String?
  licenseToken   LicenseToken? @relation(fields: [licenseTokenId], references: [id])
  @@index([userId])
  @@index([status])
  @@index([period])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum District {
  INDIE_BLOCKS
  DOWNTOWN_PRIME
  LABEL_ROW
}

model Studio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  bio         String?  @db.Text
  district    District @default(INDIE_BLOCKS)
  level       Int      @default(1)
  bannerUrl   String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VersusMatch {
  id        String       @id @default(cuid())
  songAId   String
  songBId   String
  songA     Song         @relation("VersusA", fields: [songAId], references: [id], onDelete: Cascade)
  songB     Song         @relation("VersusB", fields: [songBId], references: [id], onDelete: Cascade)
  votesA    Int          @default(0)
  votesB    Int          @default(0)
  status    VersusStatus @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime     @default(now())
  votes VersusVote[]
  @@index([status])
  @@index([endsAt])
  @@index([songAId])
  @@index([songBId])
}

enum VersusStatus {
  ACTIVE
  COMPLETED
}

model VersusVote {
  id          String      @id @default(cuid())
  matchId     String
  match       VersusMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  votedSongId String
  createdAt DateTime @default(now())
  @@unique([matchId, userId])
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  ownerId     String   @unique
  owner       User     @relation("LabelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  logoUrl     String?
  bio         String?  @db.Text
  revSharePct Decimal  @default(10) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artists LabelArtist[]
}

model LabelArtist {
  id          String            @id @default(cuid())
  labelId     String
  label       Label             @relation(fields: [labelId], references: [id], onDelete: Cascade)
  artistId    String
  artist      User              @relation("LabelArtistUser", fields: [artistId], references: [id], onDelete: Cascade)
  revSharePct Decimal           @db.Decimal(5, 2)
  status      LabelArtistStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  @@unique([labelId, artistId])
}

enum LabelArtistStatus {
  PENDING
  ACTIVE
  TERMINATED
}

model AdPlacement {
  id        String     @id @default(cuid())
  location  AdLocation
  title     String
  mediaUrl  String
  linkUrl   String?
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  price     Decimal    @db.Decimal(10, 2)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
}

enum AdLocation {
  MARKETPLACE_BANNER
  STUDIO_SIDEBAR
  CITY_BILLBOARD
  VERSUS_BANNER
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([userId, read])
  @@index([userId, createdAt])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedById String? @unique
  usedBy   User?   @relation("InviteUsed", fields: [usedById], references: [id])
}

model UserBadge {
  id        String    @id @default(cuid())
  type      BadgeType
  awardedAt DateTime  @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type])
}

enum BadgeType {
  EARLY_ADOPTER
  INVITE_5
  INVITE_10
  INVITE_50
  FIRST_BATTLE_WIN
  FIRST_LICENSE_SOLD
  LICENSE_HOLDER
  TOP_ARTIST
}

model Auction {
  id       String @id @default(cuid())
  songId   String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  sellerId String
  seller   User   @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  startingBid  Decimal  @db.Decimal(10, 2)
  reservePrice Decimal? @db.Decimal(10, 2)
  currentBid   Decimal? @db.Decimal(10, 2)
  winnerId String?
  winner   User?   @relation("AuctionWinner", fields: [winnerId], references: [id])
  status    AuctionStatus @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bids AuctionBid[]
  @@index([status, endsAt])
  @@index([songId])
  @@index([sellerId])
}

enum AuctionStatus {
  ACTIVE
  ENDED
  SETTLED
  EXPIRED
  CANCELLED
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation("AuctionBidder", fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  @@index([auctionId, amount(sort: Desc)])
  @@index([bidderId])
}

model BattleRoyale {
  id        String              @id @default(cuid())
  creatorId String
  creator   User                @relation("BattleRoyaleCreator", fields: [creatorId], references: [id])
  status    VersusStatus        @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime            @default(now())
  entries   BattleRoyaleEntry[]
  votes     BattleRoyaleVote[]
  @@index([status])
  @@index([endsAt])
}

model BattleRoyaleEntry {
  id       String       @id @default(cuid())
  battleId String
  battle   BattleRoyale @relation(fields: [battleId], references: [id], onDelete: Cascade)
  songId   String
  song     Song         @relation("BattleRoyaleEntries", fields: [songId], references: [id], onDelete: Cascade)
  votes    Int          @default(0)
  position Int
}

model BattleRoyaleVote {
  id        String       @id @default(cuid())
  battleId  String
  battle    BattleRoyale @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("BattleRoyaleVotes", fields: [userId], references: [id], onDelete: Cascade)
  songId    String
  createdAt DateTime     @default(now())
  @@unique([battleId, userId])
  @@index([battleId])
}

model DominanceHistory {
  id        String   @id @default(cuid())
  songId    String
  songTitle String
  artistId  String
  artist    String
  rank      Int
  power     Float    @default(0)
  eventType DominanceEventType
  startedAt DateTime @default(now())
  endedAt   DateTime?
  metadata  Json?
  @@index([songId, startedAt])
  @@index([artistId, startedAt])
  @@index([rank, startedAt])
}

model ArtistDominanceStats {
  id               String   @id @default(cuid())
  artistId         String   @unique
  artist           String
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  totalWins        Int      @default(0)
  totalCrownHours  Float    @default(0)
  lastCrownedAt    DateTime?
  lastLostCrownAt  DateTime?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  @@index([totalWins])
  @@index([currentStreak])
}

model RankedSeason {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      SeasonStatus @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  resetBoosts Boolean      @default(false)
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  standings   SeasonStanding[]
  rewards     SeasonReward[]
  ceremonies  SeasonResetCeremony[]
  @@index([status, startsAt, endsAt])
}

model SeasonStanding {
  id              String     @id @default(cuid())
  seasonId        String
  season          RankedSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  artistId        String
  artist          String
  songId          String?
  songTitle       String?
  league          LeagueTier @default(BRONZE)
  points          Float      @default(0)
  peakRank        Int?
  currentRank     Int?
  crownWins       Int        @default(0)
  longestStreak   Int        @default(0)
  crownHours      Float      @default(0)
  promotionLocked Boolean    @default(false)
  updatedAt       DateTime   @updatedAt
  createdAt       DateTime   @default(now())
  @@unique([seasonId, artistId])
  @@index([seasonId, points])
  @@index([seasonId, league, points])
}

model SeasonReward {
  id          String       @id @default(cuid())
  seasonId    String
  season      RankedSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  artistId    String
  artist      String
  rank        Int
  league      LeagueTier
  rewardType  RewardType
  title       String
  description String
  value       Decimal?     @db.Decimal(10, 2)
  status      RewardStatus @default(PENDING)
  issuedAt    DateTime?
  createdAt   DateTime     @default(now())
  metadata    Json?
  @@index([seasonId, rank])
  @@index([artistId, status])
}

model SeasonResetCeremony {
  id              String         @id @default(cuid())
  seasonId        String
  season          RankedSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  status          CeremonyStatus @default(SCHEDULED)
  winnerArtistId  String?
  winnerArtist    String?
  winnerSongId    String?
  winnerSongTitle String?
  headline        String
  startsAt        DateTime
  completedAt     DateTime?
  nextSeasonSlug  String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  @@index([seasonId, status])
  @@index([startsAt])
}

enum SeasonStatus {
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  CROWN
}

enum RewardType {
  CASH
  BOOST_CREDITS
  FREE_PLACEMENT
  BADGE
  FEATURED_SLOT
}

enum RewardStatus {
  PENDING
  ISSUED
  CLAIMED
  EXPIRED
}

enum CeremonyStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum DominanceEventType {
  CROWN_WON
  CROWN_LOST
  RANK_GAINED
  RANK_LOST
  BOOST_APPLIED
  PLACEMENT_WON
}
