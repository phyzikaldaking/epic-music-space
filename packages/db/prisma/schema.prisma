// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Existing schema retained above in prior commits. Additive dominance models below.

model DominanceHistory {
  id        String   @id @default(cuid())
  songId    String
  songTitle String
  artistId  String
  artist    String
  rank      Int
  power     Float    @default(0)
  eventType DominanceEventType
  startedAt DateTime @default(now())
  endedAt   DateTime?
  metadata  Json?

  @@index([songId, startedAt])
  @@index([artistId, startedAt])
  @@index([rank, startedAt])
}

model ArtistDominanceStats {
  id               String   @id @default(cuid())
  artistId         String   @unique
  artist           String
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  totalWins        Int      @default(0)
  totalCrownHours  Float    @default(0)
  lastCrownedAt    DateTime?
  lastLostCrownAt  DateTime?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([totalWins])
  @@index([currentStreak])
}

enum DominanceEventType {
  CROWN_WON
  CROWN_LOST
  RANK_GAINED
  RANK_LOST
  BOOST_APPLIED
  PLACEMENT_WON
}
