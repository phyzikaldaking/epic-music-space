  title            String
  slug             String
  synopsis         String               @db.Text
  seasonNumber     Int                  @default(1)
  episodeNumber    Int                  @default(1)
  status           PodcastEpisodeStatus @default(DRAFT)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  audioUrl         String?
  coverUrl         String?
  muxUploadId      String?              @unique
  muxAssetId       String?              @unique
  muxPlaybackId    String?              @unique
  videoStatus      PostVideoStatus      @default(NONE)
  videoDurationSec Int?
  videoAspectRatio String?
  transcript       String?              @db.Text
  captionsUrl      String?
  durationSec      Int?
  clipCount        Int                  @default(0)
  viewCount        Int                  @default(0)
  playCount        Int                  @default(0)
  roomId           String?
