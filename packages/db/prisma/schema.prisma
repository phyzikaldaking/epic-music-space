enum BadgeType {
  EARLY_ADOPTER
  INVITE_5
  INVITE_10
  INVITE_50
  FIRST_BATTLE_WIN
  FIRST_LICENSE_SOLD
  LICENSE_HOLDER
  TOP_ARTIST
}

model Auction {
  id       String @id @default(cuid())
  songId   String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  sellerId String
  seller   User   @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  startingBid  Decimal  @db.Decimal(10, 2)
  reservePrice Decimal? @db.Decimal(10, 2)
  currentBid   Decimal? @db.Decimal(10, 2)
  // Optional "buy it now" — when set and a bid >= this amount lands, the
  // auction settles immediately at that price.
  instantBuyPrice Decimal? @db.Decimal(10, 2)
  // Anti-snipe controls. windowMinutes: if a bid lands within this many
  // minutes of endsAt, extend by extensionMinutes. Defaults match the
  // previous hardcoded 2/2 behaviour in the bid route.
  antiSnipeWindowMinutes    Int @default(2)
  antiSnipeExtensionMinutes Int @default(2)
  // Soft "ending soon" notification timestamp — flipped by the cron so we
  // don't re-notify when anti-snipe extends past the original window.
  endingSoonNotifiedAt DateTime?
  winnerId String?
  winner   User?   @relation("AuctionWinner", fields: [winnerId], references: [id])
  status    AuctionStatus @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bids AuctionBid[]
  @@index([status, endsAt])
  @@index([songId])
  @@index([sellerId])
  @@index([sellerId, status])
}

enum AuctionStatus {
  ACTIVE
  ENDED
  SETTLED
  EXPIRED
  CANCELLED
}

model AuctionBid {
