model UserBehaviorEvent {
  id          String            @id @default(cuid())
  userId      String
  clipId      String
  songId      String?
  artist      String?
  eventType   BehaviorEventType
  value       Float             @default(0)
  metadata    Json?
  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  song        Song?             @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([clipId, eventType])
  @@index([songId, eventType])
}

model UserTasteProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  artistAffinity    Json     @default("{}")
  songAffinity      Json     @default("{}")
  eventAffinity     Json     @default("{}")
  skipSignals       Json     @default("{}")
  lastCalculatedAt  DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Listening sessions (live audio rooms via LiveKit)
// ─────────────────────────────────────────────────────────────

model Room {
  id            String     @id @default(cuid())
  hostId        String
  title         String
  description   String?    @db.Text
  status        RoomStatus @default(LIVE)
  maxCapacity   Int        // resolved at create time from host's tier
  // Clubhouse-style "stage" seat cap. Resolved at create time from the
  // host's tier (see roomTier.ts). HOST + SPEAKER participants count
  // toward this; the host is always seat 1. Audience (LISTENER) is
  // bounded by `maxCapacity` instead.
  stageLimit    Int        @default(2)
  // Optional studio collab linkage. When set, the room represents a
  // live producer session and the people on stage have edit rights on
  // the linked StudioProject's Yjs doc.
  studioProjectId String?  @unique
  studioProject StudioProject? @relation("RoomStudioProject", fields: [studioProjectId], references: [id], onDelete: SetNull)
  currentSongId String?    // optional: track currently playing
  sessionMode   RoomSessionMode @default(PLAYBACK)
  studioVibe    RoomStudioVibe  @default(NEON)
  spotlightUserId String?
  crowdEnergy   Int        @default(42)
  applauseBursts Int       @default(0)
  heatPoints    Json       @default("[]")
  autoQueueEnabled Boolean @default(false)
  quietMode      Boolean   @default(false)
  speakerLimitSec Int      @default(60)
  startedAt     DateTime   @default(now())
  endedAt       DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  host          User              @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  currentSong   Song?             @relation(fields: [currentSongId], references: [id], onDelete: SetNull)
  participants    RoomParticipant[]
  messages        RoomMessage[]
  timelineNotes   RoomTimelineNote[]
  recordings      RoomRecording[]
  podcastEpisodes PodcastEpisode[]
  bans            RoomBan[]
  reactions       RoomReaction[]
  polls           RoomPoll[]
  tips            RoomTip[]

  @@index([status, startedAt])
  @@index([hostId, status])
  @@index([studioProjectId])
}

enum RoomSessionMode {
  PLAYBACK
  CRITIQUE
  A_AND_R
  SILENT_NOTES
}

enum RoomStudioVibe {
  NEON
  SUNSET
  MIDNIGHT
}

model RoomRecording {
  id              String           @id @default(cuid())
  roomId          String
  egressId        String?          @unique
  status          RecordingStatus  @default(PENDING)
  playbackUrl     String?
  durationSeconds Int?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  failureReason   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  room            Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
}

enum PodcastFormat {
  VIDEO
  AUDIO
  HYBRID
}

enum PodcastCadence {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  SEASONAL
  IRREGULAR
}

enum PodcastEpisodeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model PodcastShow {
  id              String         @id @default(cuid())
  ownerId         String
  owner           User           @relation("PodcastShowOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title           String
  slug            String         @unique
  tagline         String?        @db.VarChar(160)
  description     String         @db.Text
  category        String?        @db.VarChar(80)
  format          PodcastFormat  @default(VIDEO)
  cadence         PodcastCadence @default(WEEKLY)
  coverUrl        String?
  bannerUrl       String?
  trailerAudioUrl String?
  featured        Boolean        @default(false)
  isPublished     Boolean        @default(false)
  totalViews      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  episodes        PodcastEpisode[]

  @@index([ownerId, createdAt])
  @@index([ownerId, isPublished])
  @@index([isPublished, featured, createdAt])
}

model PodcastEpisode {
  id               String               @id @default(cuid())
  showId           String
  show             PodcastShow          @relation(fields: [showId], references: [id], onDelete: Cascade)
  creatorId        String
  creator          User                 @relation("PodcastEpisodeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  slug             String
  synopsis         String               @db.Text
  seasonNumber     Int                  @default(1)
  episodeNumber    Int                  @default(1)
  status           PodcastEpisodeStatus @default(DRAFT)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  audioUrl         String?
  coverUrl         String?
  muxUploadId      String?              @unique
  muxAssetId       String?              @unique
  muxPlaybackId    String?              @unique
  videoStatus      PostVideoStatus      @default(NONE)
  videoDurationSec Int?
  videoAspectRatio String?
  transcript       String?              @db.Text
  captionsUrl      String?
  durationSec      Int?
  clipCount        Int                  @default(0)
  viewCount        Int                  @default(0)
  playCount        Int                  @default(0)
  roomId           String?
  room             Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([showId, slug])
  @@index([showId, status, publishedAt])
  @@index([creatorId, status, createdAt])
  @@index([status, publishedAt])
  @@index([roomId])
}

enum RecordingStatus {
  PENDING
  RECORDING
  READY
  FAILED
}

model RoomBan {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  bannedById  String
  reason      String?
  createdAt   DateTime @default(now())

  room        Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User @relation("RoomBanned", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy    User @relation("RoomBannedBy", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

enum RoomStatus {
  LIVE
  ENDED
}

model RoomParticipant {
  id        String                @id @default(cuid())
  roomId    String
  userId    String
  role      RoomParticipantRole   @default(LISTENER)
  handRaised Boolean              @default(false)
  joinedAt  DateTime              @default(now())
  leftAt    DateTime?

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, role])
}

enum RoomParticipantRole {
  HOST
  SPEAKER   // host has granted the floor; can publish audio
  LISTENER
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

// Audience reaction taps (🔥 ❤️ 👏). Persisted both for
// (a) leaderboards / heat-history when the session ends and (b) the
// "tipper retro" highlight rail. Realtime delivery uses Supabase
// broadcast — the DB write is best-effort and happens out-of-band.
model RoomReaction {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  // Free-form short emoji string. Validated server-side against an
  // allow-list ("🔥" | "❤️" | "👏" | "😮" | "🎧" | "💯") so we never store arbitrary
  // unicode from the broadcast channel.
  kind      String   @db.VarChar(8)
  createdAt DateTime @default(now())

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// Poll the host (or co-host) drops mid-session. "Which kick?" /
// "Keep this verse?" — audience + stage all vote. Results stream
// live via Supabase broadcast.
model RoomPoll {
  id         String   @id @default(cuid())
  roomId     String
  authorId   String
  question   String   @db.VarChar(140)
  // Up to ~6 short options. Stored as JSON array of {id, label}.
  options    Json
  // Closes automatically after closesAt; null = open until host closes.
  closesAt   DateTime?
  closedAt   DateTime?
  createdAt  DateTime @default(now())

  room       Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author     User          @relation("RoomPollAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes      RoomPollVote[]

  @@index([roomId, createdAt])
}

model RoomPollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  // Option id from the poll's options array.
  optionId  String   @db.VarChar(40)
  createdAt DateTime @default(now())

  poll      RoomPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One vote per user per poll. Re-voting overwrites via upsert.
  @@unique([pollId, userId])
  @@index([pollId])
}

// Money thrown on stage. Mirrors VersusTip but scoped to a room +
// optional target (a specific person on stage). Flow:
//   1. POST /api/rooms/:id/tip → creates a PENDING row + Stripe
//      Checkout session
//   2. Stripe webhook flips to PAID + emits a `tip.paid` broadcast
//      on the room channel
//   3. Browser animates a bill arcing from tipper → stage seat
model RoomTip {
  id                    String         @id @default(cuid())
  roomId                String
  tipperId              String
  // Who the tip is "for". Null = whole stage (split equally between
  // host + speakers when payouts run).
  recipientId           String?
  amountUsd             Decimal        @db.Decimal(10, 2)
  // Optional note the tipper attaches ("🔥 that snare!").
  note                  String?        @db.VarChar(140)
  status                RoomTipStatus  @default(PENDING)
  stripeSessionId       String?        @unique
  stripePaymentIntentId String?        @unique
  createdAt             DateTime       @default(now())
  paidAt                DateTime?

  room                  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tipper                User  @relation("RoomTipTipper", fields: [tipperId], references: [id], onDelete: Cascade)
  recipient             User? @relation("RoomTipRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([roomId, status])
  @@index([tipperId])
  @@index([recipientId])
}

enum RoomTipStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model RoomTimelineNote {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  parentId  String?
  category  RoomNoteCategory @default(GENERAL)
  resolvedAt DateTime?
  resolvedById String?
  atSeconds Int      @default(0)
  body      String   @db.Text
  createdAt DateTime @default(now())

  room      Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    RoomTimelineNote? @relation("RoomTimelineNoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   RoomTimelineNote[] @relation("RoomTimelineNoteReplies")

  @@index([roomId, createdAt])
  @@index([roomId, parentId, createdAt])
}

enum RoomNoteCategory {
  GENERAL
  MIX
  MASTER
  SONGWRITING
  ARRANGEMENT
  PERFORMANCE
}

// ─────────────────────────────────────────────────────────────
// Services marketplace — engineers offer mix/master, producers sell
// templates / beats / sample packs. Listings are bookable; an order
// is paid via Stripe and a Transaction + RevenueEvent is recorded.
// ─────────────────────────────────────────────────────────────

model ServiceListing {
  id            String              @id @default(cuid())
  providerId    String
  provider      User                @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Cascade)
  kind          ServiceListingKind
  title         String
  description   String              @db.Text
  priceUsd      Decimal             @db.Decimal(10, 2)
  deliveryDays  Int                 @default(7)
  exampleAudioUrl String?
  coverUrl      String?
  // For non-bespoke goods (templates / beats / kits): instant download.
  // Set when kind is template/beat/kit. URL surfaced after purchase.
  downloadUrl   String?             @db.Text
  status        ServiceListingStatus @default(LIVE)
  totalSold     Int                 @default(0)
  rating        Float?
  ratingCount   Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  orders        ServiceOrder[]
  reviews       ServiceReview[]

  @@index([status, kind, createdAt])
  @@index([providerId, status])
}

enum ServiceListingKind {
  MIX                 // engineer service
  MASTER              // engineer service
  MIX_MASTER_BUNDLE   // engineer service
  PRODUCER_TEMPLATE   // FL/Logic/Ableton project file
  BEAT                // producer-made beat license
  DRUM_KIT
  SAMPLE_PACK
  LESSON              // 1:1 session
}

enum ServiceListingStatus {
  LIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

model ServiceOrder {
  id           String             @id @default(cuid())
  listingId    String
  listing      ServiceListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User               @relation("ServiceBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  providerId   String
  provider     User               @relation("ServiceProviderOrders", fields: [providerId], references: [id], onDelete: Cascade)
  priceUsd     Decimal            @db.Decimal(10, 2)
  status       ServiceOrderStatus @default(PENDING)
  briefText    String?            @db.Text  // buyer's notes (BPM, key, references, etc.)
  briefUrl     String?            @db.Text  // upload link for stems
  deliverableUrl String?          @db.Text  // provider's final delivery
  deliveredAt  DateTime?
  completedAt  DateTime?                    // buyer accepted (or auto-accepted)
  acceptDeadline DateTime?                  // 14 days after deliveredAt
  revisionsUsed Int               @default(0)
  stripeSessionId      String?    @unique
  stripePaymentIntentId String?   @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages     ServiceOrderMessage[]
  revisions    ServiceOrderRevision[]
  review       ServiceReview?

  @@index([buyerId, status])
  @@index([providerId, status])
  @@index([listingId, status])
  @@index([status, acceptDeadline])
}

model ServiceOrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser  User     @relation("ServiceMessageAuthor", fields: [fromUserId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  attachmentUrl String? @db.Text
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ServiceOrderRevision {
  id        String   @id @default(cuid())
  orderId   String
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revisionNumber Int           // 1 = first delivery, 2 = first revision, ...
  deliverableUrl String  @db.Text
  message   String?  @db.Text
  deliveredAt DateTime @default(now())

  @@unique([orderId, revisionNumber])
  @@index([orderId])
}

model ServiceReview {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId   String
  listing     ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("ServiceReviewer", fields: [buyerId], references: [id], onDelete: Cascade)
  providerId  String
  rating      Int      // 1..5
  body        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([providerId, createdAt])
}

enum ServiceOrderStatus {
  PENDING               // checkout started, payment not confirmed
  PAID                  // payment received, awaiting provider work
  IN_PROGRESS           // provider acknowledged or revising
  DELIVERED             // deliverableUrl set, awaiting buyer review
  REVISION_REQUESTED    // buyer asked for changes
  COMPLETED             // buyer accepted (or auto-accepted) — payout finalized
  REFUNDED              // refunded via Stripe
  CANCELLED             // either side cancelled before delivery
}

// ─────────────────────────────────────────
// USER TIMELINE / POSTS
// ─────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  // Optional song attachment (artists posting about a track)
  songId    String?
  // Media — at most one block per post (handled in app code)
  imageUrl  String?
  // Mux video — populated by webhook when asset is ready
  muxUploadId  String?  @unique
  muxAssetId   String?  @unique
  muxPlaybackId String? @unique
  videoStatus  PostVideoStatus @default(NONE)
  videoDurationSec Int?
  videoAspectRatio String?
  isPublished Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  PostComment[]
  likes     PostLike[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([videoStatus])
}

enum PostVideoStatus {
  NONE
  UPLOADING   // direct upload created, file in transit / awaiting Mux pickup
  PROCESSING  // Mux is encoding
