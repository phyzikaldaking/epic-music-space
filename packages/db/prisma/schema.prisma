// ─────────────────────────────────────────
// SAVED TRACKS (wishlist / liked but not licensed)
// ─────────────────────────────────────────

model SavedTrack {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  @@unique([userId, songId])
  @@index([userId, createdAt])
  @@index([songId])
}

// ─────────────────────────────────────────
// VERSUS CHALLENGES (cross-artist consent flow)
// ─────────────────────────────────────────

model VersusChallenge {
  id              String    @id @default(cuid())
  challengerId    String    // user.id of the artist who initiated
  challengerSongId String   // song.id they're putting up
  opponentId      String    // user.id of the artist being challenged
  opponentSongId  String?   // song.id the opponent picks on accept
  status          VersusChallengeStatus @default(PENDING)
  message         String?   @db.Text
  durationHours   Int       @default(24)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime  // PENDING expires after 48h
  acceptedAt      DateTime?
  declinedAt      DateTime?
  matchId         String?   @unique // populated once the resulting VersusMatch is created

  @@index([opponentId, status])
  @@index([challengerId, status])
  @@index([expiresAt])
}

enum VersusChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

// ─────────────────────────────────────────
// VERSUS TIPS (tip-with-vote)
// ─────────────────────────────────────────

model VersusTip {
  id              String   @id @default(cuid())
  matchId         String
  voterId         String
  votedSongId     String
  amountUsd       Decimal  @db.Decimal(10, 2)
  status          VersusTipStatus @default(PENDING)
  stripeSessionId String?  @unique
  stripePaymentIntentId String? @unique
  createdAt       DateTime @default(now())
  paidAt          DateTime?

  @@index([matchId])
  @@index([voterId])
  @@index([status])
}

enum VersusTipStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ── Direct messages ─────────────────────────────────────────────────────
// 1:1 conversation between two users. The pair (userAId, userBId) is
// canonicalised so userAId < userBId — that way (X, Y) and (Y, X) hash to
// the same row and we get an O(1) "get or create" via the unique index.
model Conversation {
  id          String    @id @default(cuid())
  userAId     String
  userBId     String
  userA       User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages    Message[]
  lastMessageAt DateTime @default(now())
  createdAt   DateTime  @default(now())
  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String   @db.Text
  readAt         DateTime?
  createdAt      DateTime @default(now())
  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─────────────────────────────────────────────────────────────────
// RAP STOCK MARKET — verse marketplace + joint-session booking
// ─────────────────────────────────────────────────────────────────
//
// Three pieces hung off the existing User row:
//   1. VerseListing — an artist offers verses for sale. Two SKUs:
//      live joint session (calendar slot, Stripe escrow) or async
//      delivery (WAV in N days).
//   2. SessionBooking — a buyer reserves a time slot on a live
//      listing. Drives both calendar logic + the joint-room
//      handoff at session time.
//   3. ArtistStockSnapshot — daily / hourly snapshot of the
//      composite "stock price" computed from verse revenue, avg
//      verse price, repeat buyers, bookings, follower growth.
//      Drives the /market big board + per-artist sparklines.
//
// PRO+ tier-gating is enforced server-side at listing creation.
// Stock price is informational only — no share trading, no
// securities-law exposure. Verses are the only thing money flows
// through, via Stripe Connect with a 10% platform fee.

enum VerseListingKind {
  LIVE_SESSION
  ASYNC_DELIVERY
  // Engineer offerings. Same booking + escrow + signoff flow as the
  // verse SKUs above; the difference is that the SELLER is a verified
  // audio engineer and the DELIVERABLE is a mixed or mastered track
  // instead of a rapped verse. The /engineers discovery page filters
  // listings to these two kinds so engineer browse stays separate
  // from the verse marketplace.
  ENGINEER_MIX
  ENGINEER_MASTER
}

enum VerseListingStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model VerseListing {
  id              String              @id @default(cuid())
  sellerId        String
  seller          User                @relation("VerseListings", fields: [sellerId], references: [id], onDelete: Cascade)
  kind            VerseListingKind    @default(LIVE_SESSION)
  status          VerseListingStatus  @default(ACTIVE)
  title           String              @db.VarChar(120)
  description     String?             @db.Text
  // Listed price in USD. The composite stock price reads this as one
  // signal, but the artist's actual ask is what buyers pay.
  priceUsd        Decimal             @db.Decimal(10, 2)
  // For LIVE_SESSION: session duration in minutes. Buyer's calendar
  // slot is this wide. Ignored for ASYNC_DELIVERY.
  sessionMinutes  Int                 @default(60)
  // For ASYNC_DELIVERY: delivery SLA in days.
  deliveryDays    Int                 @default(3)
  // Optional preview track (artist's existing Song) buyers can hear
  // before committing.
  previewSongId   String?
  // Tags for filtering / search ("trap", "drill", "hook", "feature").
  tags            String[]            @default([])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  bookings        SessionBooking[]

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([kind])
}

enum SessionBookingStatus {
  PENDING_PAYMENT   // checkout opened, awaiting webhook
  CONFIRMED         // payment cleared, escrow held
  IN_PROGRESS       // live room is live
  COMPLETED         // both parties signed off, funds released
  CANCELLED         // refunded
  DISPUTED          // buyer raised a dispute, admin review
}

model SessionBooking {
  id                    String                @id @default(cuid())
  listingId             String
  listing               VerseListing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId               String
  buyer                 User                  @relation("SessionBookingsBought", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId              String
  seller                User                  @relation("SessionBookingsSold", fields: [sellerId], references: [id], onDelete: Cascade)
  // For LIVE_SESSION: the booked start time. Null for async.
  startAt               DateTime?
  // Live joint room created at session start. Reuses the existing
  // Room model so the buyer + seller can just join the Clubhouse
  // stage view we already built.
  roomId                String?               @unique
  status                SessionBookingStatus  @default(PENDING_PAYMENT)
  // Snapshot of the listing price at checkout time so a later price
  // change on the listing doesn't retroactively alter the contract.
  agreedPriceUsd        Decimal               @db.Decimal(10, 2)
  // For ASYNC_DELIVERY: when the seller uploads the WAV.
  deliveredAt           DateTime?
  deliveredAudioUrl     String?
  // Buyer signs off → funds release.
  buyerSignedOffAt      DateTime?
  sellerSignedOffAt     DateTime?
  // Stripe references.
  stripeSessionId       String?               @unique
  stripePaymentIntentId String?               @unique
  // Optional brief from the buyer ("16-bar verse on themes of X,
  // dark trap energy, mention the city Atlanta").
  brief                 String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([startAt])
  @@index([status, startAt])
}

// Snapshot of an artist's composite "stock price" at a point in
// time. Computed hourly by /api/cron/rap-stock-snapshot, persisted
// here so the /market page can paint sparklines without recomputing
// the whole history on every page load.
//
// The price is intentionally bounded 0..500 — it's a *ranking*
// signal, not a dollar value. Buyers pay the artist's listed verse
// price; the ticker just tells them who's hot.

// Engineer profile — sits next to the User row and carries every
// piece of metadata the booking marketplace needs to surface a pro:
// verification flag, specialties (trap mixing, rock mastering, etc),
// preferred sample rate, average turnaround time, gear chain
// description, sample work URLs, and the LUFS targets the engineer
// is comfortable hitting.
//
// One profile per User. Presence of a row + verifiedAt being non-null
// is what gates ENGINEER_MIX / ENGINEER_MASTER VerseListings on the
// create endpoint — random artists can't list themselves as
// engineers without going through verification.
model EngineerProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Free-form tagline shown on the engineer card. ~120 chars.
  tagline         String?   @db.VarChar(160)
  // Long-form bio, optional. Renders on the engineer profile page.
  bio             String?   @db.Text
  // What this engineer ships. Array tags: "trap", "rock", "vocal-tuning",
  // "stems-only", "mastering", etc. Filters the discovery grid.
  specialties     String[]  @default([])
  // Plugin / hardware chain the engineer is known for. Public so
  // artists can pick someone running the gear they want on their
  // mix. ~600 chars.
  gearChain       String?   @db.Text
  // 24-bit / 48 kHz minimum is the modern pro default; this lets the
  // engineer advertise willingness to work at higher rates (96 kHz)
  // for clients who need it.
  maxSampleRate   Int       @default(48000)
  // Stream-target LUFS the engineer is comfortable hitting. Buyers
  // shopping a -14 LUFS Spotify-ready master can filter.
  lufsTargets     Float[]   @default([])
  // Average turnaround on async deliveries, in hours. Surfaces in
  // the listing card so the buyer knows what they're committing to.
  turnaroundHours Int       @default(48)
  // Sample work — public Vercel Blob URLs to before/after stems
  // the engineer wants to show off. Capped client-side at 6.
  sampleWorkUrls  String[]  @default([])
  // Pro audio verification. An admin flips verifiedAt after
  // reviewing the engineer's portfolio + Stripe Connect KYC. Until
  // then, the engineer can still BUY services / browse, but can't
  // LIST ENGINEER_* SKUs.
  verifiedAt      DateTime?
  // Internal admin note on the verification decision. Not shown
  // publicly.
  verificationNote String?  @db.Text
  // Active toggle. Lets a verified engineer pause listings without
  // losing their badge or having to archive each listing manually.
  isAcceptingWork  Boolean  @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([verifiedAt, isAcceptingWork])
}

model ArtistStockSnapshot {
  id              String   @id @default(cuid())
  artistId        String
  artist          User     @relation("ArtistStockSnapshots", fields: [artistId], references: [id], onDelete: Cascade)
  // Normalized 0..500 price at this snapshot moment. See
  // computeStockPrice() in rapStock.ts for the formula.
  price           Decimal  @db.Decimal(10, 4)
  // Component breakdown — useful for tooltips on the artist page
  // ("price up 12% on verse revenue, flat on bookings").
  verseRevenue30d Decimal  @db.Decimal(10, 2)
  avgVersePrice   Decimal  @db.Decimal(10, 2)
  repeatBuyerRate Decimal  @db.Decimal(5, 4)   // 0..1
  bookings30d     Int
  followerGrowth30d Int
  // Snapshot time. Hourly resolution; we keep at most 90 days per
  // artist (older rows pruned by the cron job).
  capturedAt      DateTime @default(now())

  @@unique([artistId, capturedAt])
  @@index([artistId, capturedAt])
  @@index([capturedAt])
}

// ─────────────────────────────────────────────────────────────────
// AI BRAIN — feedback, marketing engine, beat learning
// ─────────────────────────────────────────────────────────────────
//
// Three intertwined systems that share one Postgres home so the
// platform can introspect itself end-to-end:
//
//   FeedbackEntry      — raw + LLM-extracted user feedback
//   AiInsight          — rolled-up themes across many entries
//                        (the "what the platform knows" brain)
//   MarketingPlan      — weekly self-written growth plan
//   MarketingPost      — concrete output (SEO page, social post,
//                        community comment, email)
//   BeatEmbedding      — vector index of every published beat for
//                        similar-pattern suggestions; foundation
//                        for an eventual custom diffusion model.
//
// All five use the existing User row for authorship / actor refs.
// Embeddings use pgvector (added via raw SQL in the migration since
// Prisma doesn't have a native vector column yet) — we read/write
// via Prisma's $queryRaw / $executeRaw.

enum FeedbackSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  BUG
  FEATURE_REQUEST
}

model FeedbackEntry {
  id              String              @id @default(cuid())
  // Null when feedback comes from an anonymous visitor.
  userId          String?
  user            User?               @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)
  // Raw user-typed text. Capped at ~4k chars; longer = truncated
  // server-side.
  body            String              @db.Text
  // LLM-extracted fields. Populated asynchronously after insert by
  // /api/cron/feedback-extract — the user's submit doesn't block on
  // an LLM call.
  sentiment       FeedbackSentiment?
  // Free-form short tag the LLM picks: "recording", "beat-machine",
  // "stock-market", "pricing", etc. Drives the admin theme rollups.
  feature         String?             @db.VarChar(60)
  // One-sentence summary of what the user wants. Easier to scan in
  // the admin dashboard than the raw paragraph.
  summary         String?             @db.VarChar(280)
  // Page path where the feedback was submitted. Useful for "the
  // /studio page gets the most bug reports" rollups.
  pagePath        String?             @db.VarChar(200)
  // Contextual signal: was this a chat-widget submission or an
  // inline micro-survey (post-record / post-purchase)?
  channel         String?             @db.VarChar(40)
  // Set when the LLM has processed this row.
  extractedAt     DateTime?
  // Admin / engineering action — set when someone files a ticket
  // for this, ships a fix, etc.
  actionedAt      DateTime?
  actionedNote    String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([sentiment, createdAt])
  @@index([feature, createdAt])
  @@index([extractedAt])
}

// Rolled-up themes the AI noticed across many FeedbackEntry rows.
// The weekly insight cron clusters recent entries and writes one
// row per theme ("plugin host crashes for Windows users",
// "producers want vocal pitch correction faster"). The admin
// dashboard surfaces these so the team can prioritise.
model AiInsight {
  id              String              @id @default(cuid())
  kind            String              @db.VarChar(40)   // "feedback-theme" | "growth-signal" | "abuse-pattern"
  title           String              @db.VarChar(200)
  body            String              @db.Text
  // 0..1 confidence the LLM assigned to the theme. Surface ordering.
  confidence      Decimal             @db.Decimal(5, 4)
  // Source rows that contributed (FeedbackEntry ids).
  evidenceIds     String[]            @default([])
  // Suggested action ("add a Windows installer page", "promote vocal
  // warmup feature to homepage"). Recommendations only — no auto-
  // exec without admin signoff.
  recommendation  String?             @db.Text
  resolvedAt      DateTime?
  resolvedNote    String?             @db.Text
  createdAt       DateTime            @default(now())

  @@index([kind, createdAt])
  @@index([resolvedAt])
}

enum MarketingPostKind {
  SEO_PAGE
  SOCIAL_TWITTER
  SOCIAL_INSTAGRAM
  SOCIAL_TIKTOK
  COMMUNITY_COMMENT
  EMAIL_BLAST
}

enum MarketingPostStatus {
  DRAFT             // generated, awaiting auto-publish or human review
  SCHEDULED         // queued for a future publish time
  PUBLISHED
  FAILED
  CANCELLED
}

model MarketingPlan {
  id              String              @id @default(cuid())
  // The cron writes one plan per week. Title is human-friendly so
  // the admin can scan ("Week of May 12 · Pivot to producer tools").
  title           String              @db.VarChar(200)
  // Plan summary, ~500 chars, written by the LLM after reading
  // platform analytics + recent feedback insights.
  summary         String              @db.Text
  // Structured plan rows the executor can act on ({kind, target,
  // copy, scheduledAt}). Validated server-side before each
  // MarketingPost row is created.
  actions         Json
  // Reflects whether any of the plan's actions actually shipped.
  executedAt      DateTime?
  // Roll-up KPIs the cron reads next week to evaluate this plan
  // ("how did the spotlight artist perform after we ran the SEO
  // page on them?").
  resultMetrics   Json?
  createdAt       DateTime            @default(now())

  posts           MarketingPost[]

  @@index([createdAt])
}

model MarketingPost {
  id              String                @id @default(cuid())
  planId          String?
  plan            MarketingPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  kind            MarketingPostKind
  status          MarketingPostStatus   @default(DRAFT)
  // What this is *about* — usually a Song / VerseListing / DrumKitPack
  // / User. We don't FK to keep it polymorphic; the row carries
  // {model, id} in the targetRef JSON.
  targetRef       Json?
  // The actual creative output. For SEO_PAGE: { slug, html, meta }.
  // For SOCIAL_*: { caption, mediaUrl, hashtags }. For
  // COMMUNITY_COMMENT: { commentBody, targetUrl }.
  payload         Json
  // External id from the destination platform (tweet id, post id,
  // etc) — populated on publish success.
  externalId      String?
  // For SCHEDULED posts.
  scheduledFor    DateTime?
  publishedAt     DateTime?
  failedReason    String?               @db.Text
  // Performance the cron reads back later to feed AiInsight.
  impressions     Int                   @default(0)
  clicks          Int                   @default(0)
  engagements     Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, scheduledFor])
  @@index([kind, publishedAt])
  @@index([planId])
}

// Vector index of every published song's beat pattern + genre + BPM
// + kit. Used by the studio's "similar-pattern" suggestion endpoint
// and as the dataset foundation for an eventual custom diffusion
// model (see docs/beat-diffusion-roadmap.md).
//
// The actual vector column is declared in the SQL migration via
// `vector(384)` (pgvector). Prisma doesn't have a native vector
// type, so we store one in raw SQL and read it via $queryRaw. This
// model row carries the structured *metadata* alongside.
model BeatEmbedding {
  id              String              @id @default(cuid())
  // Source song. If the song is deleted the embedding becomes
  // orphan trivia — clear it.
  songId          String              @unique
  // Tagged fields, all extractable from the song row at index time.
  bpm             Int
  genre           String?             @db.VarChar(40)
  kit             String?             @db.VarChar(40)
  // Hex-encoded 16-step pattern across the 8 lanes — same shape the
  // studio context store uses. Saves us re-parsing the JSON when we
  // want to render the matched pattern in suggestions.
  patternHex      String              @db.VarChar(80)
  // Embedding dim — 384 fits MiniLM / OpenAI-small embeddings.
  // The actual vector column is added via raw SQL.
  createdAt       DateTime            @default(now())

  @@index([bpm])
  @@index([genre])
  @@index([kit])
}
// Written BEFORE the Resend API call. A cron flushes PENDING rows that
// weren't confirmed sent within 5 min (delivery gap). Idempotent on
// messageId — prevents duplicates on retry.
// ─────────────────────────────────────────

model EmailOutbox {
  id          String          @id @default(cuid())
  messageId   String          @unique // deterministic — sha256(userId+type+day)
  userId      String?
  to          String
  subject     String
  html        String          @db.Text
  text        String?         @db.Text
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int             @default(0)
  lastError   String?         @db.Text
  sentAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

enum EmailOutboxStatus {
  PENDING   // not yet sent
  SENT      // Resend API confirmed
  FAILED    // max retries exceeded
  SUPPRESSED // recipient bounced / complained
}

// ─────────────────────────────────────────
// PROMO CODE FREEZE — admin freeze control
// Stripe coupon IDs can be frozen to stop all new redemptions.
// ─────────────────────────────────────────

model PromoCodeFreeze {
  id         String   @id @default(cuid())
  couponId   String   @unique // Stripe coupon ID
  frozenBy   String   // admin userId
  frozenAt   DateTime @default(now())
  reason     String?  @db.Text
  unfrozenAt DateTime?
  unfrozenBy String?

  @@index([couponId])
  @@index([frozenAt])
}

// ── Verzuz: head-to-head artist-vs-artist with up to 10 song rounds ──
// Modelled after Swizz Beatz / Timbaland Verzuz: two artists pick a
// curated setlist (up to 10 songs each), and fans vote round-by-round
// on which song wins that head-to-head. Whoever takes the most rounds
// wins the match. Auto-advances on timer; voting on a future round is
// rejected so the experience is paced like a real DJ set.
model VerzuzMatch {
  id            String       @id @default(cuid())
  artistAId     String
  artistBId     String
  artistA       User         @relation("VerzuzArtistA", fields: [artistAId], references: [id], onDelete: Cascade)
  artistB       User         @relation("VerzuzArtistB", fields: [artistBId], references: [id], onDelete: Cascade)
  // Display fields cached at create-time so a profile-rename doesn't
  // change the headline mid-match.
  artistAName   String
  artistBName   String
  // Optional theme — "Hip-hop legends," "Reggaeton kings" etc. Just
  // copy on the stage page; never affects voting eligibility.
  theme         String?
  totalRounds   Int          @default(10)
  currentRound  Int          @default(1)
  // Each round runs `roundDurationSec`. When the round timer expires
  // the cron auto-advances; the artists can never advance early.
  roundDurationSec Int       @default(180)
  status        VerzuzStatus @default(SCHEDULED)
  startsAt      DateTime
  endsAt        DateTime?
  // Event-grade fields. A "MAIN_EVENT" is the planned 10-song-by-10-song
  // showdown with hype reminders, RSVPs, and a host card. "SPEED" is the
  // quick 1-song-vs-1-song format for a casual battle. Defaults to MAIN.
  tier          String       @default("MAIN_EVENT")
  hostNotes     String?
  coverImageUrl String?
  // Counters for cron-driven reminders so we don't double-send.
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?
  reminder5mSentAt  DateTime?
  liveStartSentAt   DateTime?
  rounds        VerzuzRound[]
  votes         VerzuzVote[]
  rsvps         VerzuzRSVP[]
  reactions     VerzuzReaction[]
  messages      VerzuzMessage[]
  createdAt     DateTime     @default(now())
  @@index([status, startsAt])
  @@index([artistAId])
  @@index([artistBId])
}

// "Going" / "Interested" RSVPs drive the pre-event reminder cron and
// give the audience a number to look forward to. One row per (match, user).
model VerzuzRSVP {
  id        String      @id @default(cuid())
  matchId   String
  match     VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String      @default("GOING") // GOING | INTERESTED
  createdAt DateTime    @default(now())
  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId])
}

// Live-stream reactions ("🔥", "👏", "🐐"). Append-only; the UI counts
// per-emoji on read. Cap server-side via rate-limit.
model VerzuzReaction {
  id          String      @id @default(cuid())
  matchId     String
  match       VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundNumber Int
  emoji       String
  createdAt   DateTime    @default(now())
  @@index([matchId, roundNumber])
  @@index([matchId, createdAt])
}

// Live audience chat — one row per message. Moderator (either artist)
// can hide rows by flipping isHidden.
model VerzuzMessage {
  id          String      @id @default(cuid())
  matchId     String
  match       VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roundNumber Int
  body        String
  isHidden    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  @@index([matchId, createdAt])
  @@index([matchId, roundNumber])
}

enum VerzuzStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

// Two-sided invitation flow that lets cross-artist Verzuz matches actually
// happen. The challenger proposes opponent + theme + setlist + start time;
// the opponent accepts (picking their own setlist) which atomically creates
// the real VerzuzMatch with rounds zipped 1:1. Mirrors VersusChallenge.
model VerzuzChallenge {
  id                       String                @id @default(cuid())
  challengerId             String                // user.id of the artist who initiated
  opponentId               String                // user.id of the artist being challenged
  challengerSongIds        String[]              // 1-10 song IDs from the challenger
  opponentSongIds          String[]              // populated on accept; same length
  proposedTheme            String?
  proposedTotalRounds      Int                   @default(10)
  proposedRoundDurationSec Int                   @default(180)
  proposedTier             String                @default("MAIN_EVENT")
  proposedStartsAt         DateTime
  status                   VerzuzChallengeStatus @default(PENDING)
  message                  String?               @db.Text
  createdAt                DateTime              @default(now())
  expiresAt                DateTime              // PENDING expires after 48h
  acceptedAt               DateTime?
  declinedAt               DateTime?
  matchId                  String?               @unique // VerzuzMatch row created on accept

  @@index([opponentId, status])
  @@index([challengerId, status])
  @@index([expiresAt])
}

enum VerzuzChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model VerzuzRound {
  id            String   @id @default(cuid())
  matchId       String
  match         VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  roundNumber   Int
  songAId       String
  songBId       String
  songA         Song     @relation("VerzuzRoundSongA", fields: [songAId], references: [id], onDelete: Cascade)
  songB         Song     @relation("VerzuzRoundSongB", fields: [songBId], references: [id], onDelete: Cascade)
  votesA        Int      @default(0)
  votesB        Int      @default(0)
  // Set when the round closes (timer expires or moderator advances).
  // Null while live; "A" / "B" / "TIE" when locked.
  winner        String?
  createdAt     DateTime @default(now())
  @@unique([matchId, roundNumber])
  @@index([matchId, roundNumber])
}

model VerzuzVote {
  id            String   @id @default(cuid())
  matchId       String
  match         VerzuzMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  roundNumber   Int
  voterId       String
  voter         User     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  votedSongId   String
  createdAt     DateTime @default(now())
  // One vote per (match, round, voter). Voter can change their pick
  // until the round closes, but the unique constraint forces upsert.
  @@unique([matchId, roundNumber, voterId])
  @@index([matchId, roundNumber])
}

// ─────────────────────────────────────────
// PUSH NOTIFICATIONS
// ─────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Lightweight daily session ping from native app shell.
// Durable trail of authentication events (success + failure). PostHog gets the
// same events for product analytics, but those go away if POSTHOG_KEY isn't
// configured or the project is paused — this table is the always-on forensic
// log. Email is stored already-masked; never write a plaintext password or token.
model AuthEvent {
  id          String   @id @default(cuid())
  event       String   // matches AuthEventName union
  userId      String?
  emailMasked String?
  ipHash      String?  // SHA256 of IP, never the raw value
  userAgent   String?
  reason      String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Durable fraud/abuse event ledger. This is separate from product analytics so
// operators can investigate abuse even when third-party analytics are disabled.
model RiskEvent {
  id            String   @id @default(cuid())
  eventType     String   // suspicious_signup | fake_play | fake_vote | failed_payment | content_report
  severity      String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  status        String   @default("OPEN") // OPEN | DISMISSED | ESCALATED | ACTIONED
  actorUserId   String?
  targetUserId  String?
  songId        String?
  reportId      String?
  transactionId String?
  ipHash        String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?
  reviewedById  String?

  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([status, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([songId, createdAt])
  @@index([createdAt])
}

// Tracks real-world version distribution + platform mix without a 3P SDK.
model NativeTelemetryEvent {
  id         String   @id @default(cuid())
  userId     String?  // null for unauthenticated sessions
  platform   String   // "ios" | "android"
  osVersion  String
  appVersion String
  appBuild   String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Guest shareable links — anonymous WAV uploads from /studio/try.
// Visitor makes a beat, hits "Get a shareable link," we upload the
// audio, mint a public token, and they get /share/[token] to text
// to a friend. The friend lands on a public page with the audio +
// a "Try EMS Studio yourself" CTA — that's the viral loop.
//
// 7-day TTL so the public bucket doesn't grow unbounded; a daily
// cron purges expired rows + their underlying audio files.
model GuestShare {
  id         String   @id @default(cuid())
  // Public, URL-safe token. Generated client/server-side as a 16-byte
  // base64url string. Indexed unique because /share/[token] hits this.
  token      String   @unique
  audioUrl   String
  fileName   String
  ipHash     String?  // for spam/rate-limit, not for tracking
  listenCount Int     @default(0)
  durationSec Int?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// PLAYLISTS
// User-curated collections of songs. Loose foreign keys (no Prisma
// relations) follow the SavedTrack pattern — keeps cascade behavior
// explicit at the application layer and avoids cross-domain coupling.
// ─────────────────────────────────────────

model Playlist {
  id          String   @id @default(cuid())
  ownerId     String
  name        String   @db.VarChar(120)
  description String?  @db.Text
  coverUrl    String?
  // When true, /playlists/[id] is reachable by anyone with the link
  // (used for share-by-link). When false, only the owner can view it.
  isPublic    Boolean  @default(false)
  // URL-safe public share token. Issued lazily on first share so we
  // don't leak ids; rotated when the owner clicks "regenerate link".
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([isPublic, updatedAt])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  songId     String
  // Manual ordering — front-end persists drag-to-reorder by writing
  // back position values. Float so we can insert between two rows
  // without renumbering the whole list.
  position   Float    @default(0)
  addedAt    DateTime @default(now())
  // Who added the track. Always equals the playlist owner today, but
  // tracked separately so collaborative playlists become a 1-column
  // change instead of a backfill.
  addedById  String

  @@unique([playlistId, songId])
  @@index([playlistId, position])
  @@index([songId])
}

// ─────────────────────────────────────────
// REDEEM CODES
// Admin-mintable codes that grant bonus song slots, PRO trial time,
// boost credits, or license-fee waivers. The reward shape is JSON
// so we can ship new reward types without a migration; the consume
// site validates the shape at runtime.
// ─────────────────────────────────────────

model RedeemCode {
  id          String   @id @default(cuid())
  // Human-typeable code (e.g. EMS-WELCOME-5K). Uppercased server-side
  // before lookup so case never matters. Unique so two batches never
  // collide.
  code        String   @unique
  // Reward payload validated at consume time. Shape:
  // { bonusSongSlots?: number, trialDays?: number,
  //   freeBoostCredits?: number, freeLicenseFeeWaivers?: number, note?: string }
  reward      Json
  // Optional cap on how many users can redeem. Null = unlimited (but
  // single-user codes still enforced by the unique on RedeemRedemption).
  maxUses     Int?
  uses        Int      @default(0)
  // Optional expiry. Past expiresAt, the code is dead even if it has
  // uses remaining.
  expiresAt   DateTime?
  // Free-form description for the admin dashboard ("Open mic giveaway",
  // "Reddit launch bundle"). Never shown to redeemers.
  description String?  @db.Text
  // Admin who minted this batch — useful when investigating abuse.
  createdById String
  createdAt   DateTime @default(now())
  // Soft-disable without deleting the row. Frozen codes return a
  // generic "this code is no longer active" error.
  frozenAt    DateTime?

  @@index([expiresAt])
  @@index([createdById, createdAt])
}

model RedeemRedemption {
  id        String   @id @default(cuid())
  codeId    String
  userId    String
  // Snapshot of the reward as granted, so downstream audits don't have
  // to re-resolve the parent RedeemCode (which an admin may have
  // edited or frozen since).
  reward    Json
  createdAt DateTime @default(now())

  // Each user can redeem a given code at most once. Stops re-runs from
  // double-granting when a network blip causes the client to retry.
  @@unique([codeId, userId])
  @@index([userId, createdAt])
}
