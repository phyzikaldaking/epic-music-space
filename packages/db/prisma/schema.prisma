// ─────────────────────────────────────────
// EMAIL DRIP SEQUENCE TRACKING
// ─────────────────────────────────────────

model EmailDripSent {
  id        String   @id @default(cuid())
  userId    String
  step      String   // "welcome_day_0", "tips_day_1", "payout_day_3"
  sentAt    DateTime @default(now())

