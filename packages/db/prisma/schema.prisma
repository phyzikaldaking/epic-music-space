// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  username         String?          @unique
  image            String?
  passwordHash     String?
  role             Role             @default(LISTENER)
  subscriptionTier SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  emailVerified    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  trialExpiresAt   DateTime?
  stripeConnectId  String?          @unique

  // ── Redeem-code grants ─────────────────────────────────────
  // Stackable rewards from /redeem. Kept on the user (vs. a separate
  // entitlements table) because they're per-account counters that
  // never expire on their own — the consume sites decrement them.
  // Reset to 0 only on hard suspend; subscription downgrades don't
  // clear granted slots (we promised them, we keep them).
  bonusSongSlots         Int @default(0)  // adds to maxSongs
  freeBoostCredits       Int @default(0)  // 1 free Boost per credit
  freeLicenseFeeWaivers  Int @default(0)  // 1 fee-free license sale per

  // ── Payout method preference ───────────────────────────────
  // Artists pick STRIPE (default) or PAYPAL when they hit the dashboard
  // Stripe Connect does most of the heavy lifting; PayPal is a fallback
  // for countries Stripe Connect won't service. Only one is "active" at
  // a time — the one we route earned funds through. paypalPayoutEmail
  // is the email PayPal credits the payout to (verified via webhook
  // before any real payout fires).
  payoutMethod      PayoutMethod @default(STRIPE)
  paypalPayoutEmail String?

  // ── Activity ───────────────────────────────────────────────
  // Bumped whenever the user opens the dashboard. Powers the "since you
  // last visited" summary that's shown on next dashboard load.
  lastSeenAt         DateTime?

  // ── Risk / trust ───────────────────────────────────────────
  // suspicionScore: additive int bumped by webhooks and admin actions.
  // flaggedAt: first time score exceeded threshold or admin manually flagged.
  // isSuspended: hard block — all sensitive actions rejected.
  // emailBounced: Resend bounce/complaint webhook sets this; suppresses future sends.
  suspicionScore  Int       @default(0)
  flaggedAt       DateTime?
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?   @db.Text
  emailBounced    Boolean   @default(false)
  emailBouncedAt  DateTime?

  // Session-revocation marker. JWTs issued before this timestamp are
  // treated as signed-out by the session callback. Set whenever we want
  // every existing session for this user to die — password reset,
  // suspend, admin-forced sign-out, etc.
  sessionsRevokedAt DateTime?

  // ── Identity / verification ────────────────────────────────
  // Verified-artist badge. Set by an admin via /api/admin/users/[id]/verify.
  isVerified         Boolean  @default(false)
  verifiedAt         DateTime?
  // Stripe Identity verification — separate from the verified-artist
  // badge. Used for KYC-grade gating on Connect payouts above platform
  // thresholds. Webhook flips identityVerifiedAt when the verification
  // session reports `verified`.
  stripeIdentitySessionId String?  @unique
  identityVerifiedAt      DateTime?

  // ── Stripe Connect compliance ──────────────────────────────
  connectChargesEnabled  Boolean   @default(false)
  connectPayoutsEnabled  Boolean   @default(false)
  connectDetailsSubmitted Boolean  @default(false)  // mirrors Stripe's account.details_submitted; gates payout-eligible UI
  connectRequirements    Json?     // Stripe requirements object (currently_due, errors, etc.)
  connectCountry         String?   // ISO 3166-1 alpha-2 from Stripe account

  // ── Tax compliance ─────────────────────────────────────────
  taxFormStatus TaxFormStatus @default(NOT_COLLECTED)
  taxIdType     String?       // e.g. "us_ein", "us_ssn", "gb_vat", "eu_vat"

  accounts Account[]
  sessions Session[]
  songs        Song[]
  licenses     LicenseToken[]
  // Stems this user has pulled from the Loop Browser into their tracks.
  stemUsages   StemUsage[]
  // Songs this user has expressed interest in becoming a co-writer on.
  coWriterInterest CoWriterInterest[]
  transactions Transaction[]
  payouts      Payout[]
  studio           Studio?
  studioProjects   StudioProject[]
  drumKitPacks     DrumKitPack[]    @relation("DrumKitPacks")
  podcastShows     PodcastShow[]    @relation("PodcastShowOwner")
  podcastEpisodes  PodcastEpisode[] @relation("PodcastEpisodeCreator")
  ownedLabel       Label?         @relation("LabelOwner")
  labelMemberships LabelArtist[]  @relation("LabelArtistUser")
  adPlacements     AdPlacement[]
  notifications    Notification[]
  versusVotes      VersusVote[]
  battlesCreated   BattleRoyale[]     @relation("BattleRoyaleCreator")
  royaleVotes      BattleRoyaleVote[] @relation("BattleRoyaleVotes")
  following        UserFollow[]   @relation("Follower")
  followers        UserFollow[]   @relation("Following")
  inviteCodesCreated InviteCode[] @relation("InviteCreator")
  inviteCodeUsed     InviteCode?  @relation("InviteUsed")
  badges UserBadge[]
  auctionsCreated Auction[]    @relation("AuctionSeller")
  auctionsWon     Auction[]    @relation("AuctionWinner")
  auctionBids     AuctionBid[] @relation("AuctionBidder")
  behaviorEvents  UserBehaviorEvent[]
  tasteProfile    UserTasteProfile?
  roomsHosted        Room[]              @relation("RoomHost")
  roomParticipations RoomParticipant[]
  roomMessages       RoomMessage[]
  roomTimelineNotes  RoomTimelineNote[]
  roomBans           RoomBan[]           @relation("RoomBanned")
  roomBansIssued     RoomBan[]           @relation("RoomBannedBy")
  roomReactions      RoomReaction[]
  roomPollsAuthored  RoomPoll[]          @relation("RoomPollAuthor")
  roomPollVotes      RoomPollVote[]
  roomTipsSent       RoomTip[]           @relation("RoomTipTipper")
  roomTipsReceived   RoomTip[]           @relation("RoomTipRecipient")
  // Rap stock market: verse listings, session bookings, and the
  // hourly snapshot history that drives the ticker / sparkline.
  verseListings        VerseListing[]        @relation("VerseListings")
  sessionBookingsBought SessionBooking[]     @relation("SessionBookingsBought")
  sessionBookingsSold  SessionBooking[]      @relation("SessionBookingsSold")
  stockSnapshots       ArtistStockSnapshot[] @relation("ArtistStockSnapshots")
  feedbackEntries      FeedbackEntry[]       @relation("FeedbackAuthor")
  revenueSplits      RevenueSplit[]      @relation("RevenueSplits")
  splitSheetEntries  SplitSheetEntry[]   @relation("SplitSheetEntries")
  serviceListings    ServiceListing[]    @relation("ServiceProvider")
  serviceOrdersAsBuyer    ServiceOrder[] @relation("ServiceBuyer")
  serviceOrdersAsProvider ServiceOrder[] @relation("ServiceProviderOrders")
  serviceMessages    ServiceOrderMessage[] @relation("ServiceMessageAuthor")
  serviceReviews     ServiceReview[]    @relation("ServiceReviewer")
  posts              Post[]             @relation("PostAuthor")
  postComments       PostComment[]      @relation("PostCommentAuthor")
  postLikes          PostLike[]         @relation("PostLikeUser")
  trackComments      TrackComment[]     @relation("TrackCommentAuthor")
  trackLikes         TrackLike[]        @relation("TrackLikeUser")
  connectedAccounts  ConnectedAccount[]
  blocking           UserBlock[]        @relation("Blocker")
  blockedBy          UserBlock[]        @relation("Blocked")
  reportsFiled       UserReport[]       @relation("Reporter")
  reportsReceived    UserReport[]       @relation("Reported")
  notifPrefs         NotificationPreference[]
  conversationsAsA   Conversation[]     @relation("ConversationUserA")
  conversationsAsB   Conversation[]     @relation("ConversationUserB")
  messagesSent       Message[]          @relation("MessageSender")
  verzuzAsArtistA    VerzuzMatch[]      @relation("VerzuzArtistA")
  verzuzAsArtistB    VerzuzMatch[]      @relation("VerzuzArtistB")
  verzuzVotes        VerzuzVote[]
  verzuzRSVPs        VerzuzRSVP[]
  verzuzReactions    VerzuzReaction[]
  verzuzMessages     VerzuzMessage[]
  pushTokens         PushToken[]

  // ── Pro profile (engineers / producers) ────────────────────
  // Cinematic profile fields surfaced on /pro/[username]. Bio is short
  // — `headline` is the one-line tagline ("Grammy-nominated mix engineer
  // for Beyoncé, SZA"), `bioLong` is the full story, `coverImage` is the
  // wide cinematic banner behind the avatar.
  headline      String?  @db.VarChar(160)
  bioLong       String?  @db.Text
  coverImage    String?
  location      String?  @db.VarChar(120)
  websiteUrl    String?
  instagramUrl  String?
  twitterUrl    String?
  youtubeUrl    String?
  tiktokUrl     String?
  spotifyUrl    String?
  // Industry accolades counters (signed off by admin via UserBadge — these
  // are the public marquee numbers: "5x Grammy nominated, 3 wins, 12 Platinum").
  grammyNominations  Int @default(0)
  grammyWins         Int @default(0)
  riaaPlatinum       Int @default(0)
  riaaGold           Int @default(0)
  billboardNumberOne Int @default(0)
  // Free-form list of credits as JSON: [{ artist, title, role, year, coverUrl, spotifyUrl }]
  // Validated server-side in /api/user/profile. Capped at 50 entries.
  engineerCredits  Json?
  // Free-form list of accolades as JSON: [{ title, year, org, kind: "grammy"|"riaa-platinum"|"riaa-gold"|"billboard"|"other" }]
  engineerAccolades Json?
  // Studio / gear specs as JSON: { console, monitors, daws: string[], plugins: string[], roomTreatment }
  engineerGear Json?
  // Years of experience — surfaced in the badge wall.
  yearsExperience Int?
  // When true, the profile shows the cinematic hero treatment. Defaults
  // off for legacy users; engineers/producers can flip it on once they've
  // populated headline + cover + at least 3 credits.
  proProfilePublished Boolean @default(false)

  // Engineer Mode — pro audio sellers. The EngineerProfile row carries
  // the verification flag + service metadata that gates ENGINEER_MIX /
  // ENGINEER_MASTER VerseListings.
  engineerProfile EngineerProfile?
}

enum Role {
  LISTENER
  ARTIST
  PRODUCER
  ENGINEER
  LABEL
  ADMIN
}

enum TaxFormStatus {
  NOT_COLLECTED
  PENDING
  COLLECTED
  EXEMPT
}

enum PayoutMethod {
  STRIPE
  PAYPAL
}

enum SubscriptionTier {
  FREE
  TRIAL
  STARTER
  PRO
  PRIME
  TEAM
  LABEL_TIER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

// Connected third-party social accounts that can be used to post on behalf
// of a user. Tokens are stored encrypted in the application DB.
model ConnectedAccount {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  providerAccountId  String
  accessToken        String?  @db.Text
  refreshToken       String?  @db.Text
  expiresAt          Int?
  scope              String?
  meta               Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique  // sha256 of the raw token; raw value is only emailed
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expires])
}

model Song {
  id          String  @id @default(cuid())
  title       String
  artist      String
  genre       String?
  description String? @db.Text
  audioUrl    String
  coverUrl    String?
  bpm         Int?
  key         String?
  licensePrice    Decimal @db.Decimal(10, 2)
  revenueSharePct Decimal @db.Decimal(5, 2)
  totalLicenses   Int     @default(100)
  soldLicenses    Int     @default(0)
  isActive        Boolean @default(true)
  aiScore      Float    @default(0)
  boostScore   Float    @default(0)
  versusWins   Int      @default(0)
  versusLosses Int      @default(0)
  streamCount  Int      @default(0)
  // Integrated LUFS captured at publish time from the studio's master
  // analyser. Surfaced on the track page so license shoppers can see at
  // a glance whether the master is stream-ready (-14 LUFS target) or
  // hot/quiet. Null on legacy tracks published before the field existed
  // and on imports from outside the studio.
  masterLufs   Float?
  // Track-page views (distinct from streamCount, which counts /stream hits).
  // Lets producers compute a real funnel: viewCount -> streamCount -> licenses.
  viewCount    Int      @default(0)
  // Drafts + scheduled releases. isDraft=true keeps the song out of every
  // public surface (marketplace, trending, profile, search). scheduledAt
  // is the timestamp a cron flips isDraft -> false. Both honor the existing
  // isActive flag, which remains the producer's manual on/off switch.
  isDraft      Boolean  @default(false)
  scheduledAt  DateTime?
  // License tier variants (basic/premium/exclusive/etc.). When set, the
  // top-level licensePrice is the BASIC tier and this JSON describes
  // additional tiers. Shape: [{ id, name, priceUsd, terms, totalLicenses }].
  licenseVariants Json?
  district     District @default(INDIE_BLOCKS)
  stemUrl   String?
  stemFiles Json?
  hasStems  Boolean @default(false)
  // AI stem separation lifecycle. Populated when the artist (or a license
  // holder) hits "Generate stems" — we kick off a Demucs job on Replicate
  // and store the resulting 4 stems (vocals, drums, bass, other) into
  // stemFiles + flip hasStems=true on success.
  stemSeparationStatus      StemSeparationStatus @default(NONE)
  stemSeparationProviderId  String?
  stemSeparationError       String?
  stemSeparationStartedAt   DateTime?
  stemSeparationCompletedAt DateTime?
  // When false (default), the audio file is preview-only. Listeners can stream
  // through the proxy but cannot download the underlying file. License
  // purchase or artist opt-in (true) is required for download.
  allowFreeDownload Boolean @default(false)
  // Pay-what-you-want pricing. When ON, licensePrice is treated as the
  // minimum floor and fans pick any amount ≥ floor at checkout. The track
  // page renders an amount input instead of a fixed buy button. Off by
  // default; producers explicitly opt in when they want the tip-jar /
  // superfan model. Stripe checkout receives the chosen amount as a
  // dynamic price_data line item rather than a fixed product price.
  payWhatYouWant Boolean @default(false)
  // Legacy / vault tracks: older catalog material (e.g. "back when I used to
  // rap"). Rendered in a separate Legacy section on /studio/[username] and
  // excluded from /trending + /marketplace defaults so the new-releases
  // surface stays current.
  isLegacy            Boolean @default(false)
  originalReleaseYear Int?    // optional context for legacy tracks (e.g. 2003)
  // Auto-credit metadata captured from the studio at publish time (#30).
  // Shape: { beatKit?: string, beatKitLabel?: string,
  //          templateId?: string, templateName?: string,
  //          contributors?: Array<{ userId?: string, role: string, label: string }> }.
  // Track pages render this as a "Credits" panel so kit / template authors
  // get visible attribution and ecosystem participants are surfaced.
  credits             Json?
  // ISRC code for distribution to streaming services (#F35). Format:
  // CC-XXX-YY-NNNNN (12 chars). Allocated from a pre-purchased pool at
  // publish time when the artist opts into distribution. NULL = not
  // distributed yet (no ISRC needed for catalog-only listings).
  isrcCode            String?  @db.VarChar(15)
  // Splits sheet (#F36) — royalty / revenue percentages per contributor.
  // Shape: { contributors: Array<{ userId?: string, name: string,
  //          role: string, splitPct: number }>, signedAt: string? }.
  // Sums to <=100. signedAt timestamp set when all contributors approve.
  splitsSheet         Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artistId String
  artist_  User   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  licenses       LicenseToken[]
  transactions   Transaction[]
  payouts        Payout[]
  versusMatchesA VersusMatch[]       @relation("VersusA")
  versusMatchesB VersusMatch[]       @relation("VersusB")
  verzuzRoundsA  VerzuzRound[]       @relation("VerzuzRoundSongA")
  verzuzRoundsB  VerzuzRound[]       @relation("VerzuzRoundSongB")
  royaleEntries  BattleRoyaleEntry[] @relation("BattleRoyaleEntries")
  auctions       Auction[]
  behaviorEvents UserBehaviorEvent[]
  rooms          Room[]
  revenueEvents  RevenueEvent[]
  trackComments  TrackComment[]
  trackLikes     TrackLike[]
  // Stems of this song that have been pulled into other producers' tracks.
  stemUsagesAsSource  StemUsage[] @relation("SourceSongStems")
  // Stems from other songs that this song was built from.
  stemUsagesAsDerived StemUsage[] @relation("DerivedSongStems")
  // Fans who tapped "Become a Co-Writer" on this song. The artist
  // reviews the queue and accepts/declines; on accept a real writer
  // share is minted via the existing license/payout pipeline.
  coWriterInterest    CoWriterInterest[]
  // The royalty split agreement for this song. Optional — single-artist
  // tracks don't need one. When present and SIGNED, payouts allocate
  // RevenueSplit rows according to the entries here.
  splitSheet          SplitSheet?
  @@index([artistId])
  @@index([district])
  @@index([isActive])
  @@index([aiScore])
  @@index([isActive, aiScore, createdAt])
  @@index([isActive, genre])
  @@index([isActive, bpm])
  @@index([stemSeparationStatus])
  // Drafts + scheduled releases — used by the publish-scheduled-tracks cron
  // and by the producer "drafts" tab on /studio/manage.
  @@index([isDraft])
  @@index([scheduledAt])
}

enum StemSeparationStatus {
  NONE
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum StemKind {
  VOCALS
  DRUMS
  BASS
  OTHER
  FULL
}

// Captured intent only — Stripe checkout for the actual purchase
// happens in a follow-up flow. Status values are loose strings rather
// than an enum so we can iterate the workflow without migrations:
// PENDING / ACCEPTED / DECLINED / PAID / EXPIRED.
model CoWriterInterest {
  id                String   @id @default(cuid())
  songId            String
  song              Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  fanId             String
  fan               User     @relation(fields: [fanId], references: [id], onDelete: Cascade)
  shareBpsRequested Int      @default(50)
  priceCents        Int      @default(5000)
  message           String?
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([songId, fanId])
  @@index([songId, status])
  @@index([fanId])
}

// When a producer drags a stem from the Loop Browser into their DAW,
// a StemUsage row is created. The derived song id is filled in when
// they publish the resulting track via /studio/new. The royalty
// waterfall job uses these rows to split future revenue back to the
// source artists (shareBps = basis points, default 200 = 2% per stem).
model StemUsage {
  id             String   @id @default(cuid())
  sourceSongId   String
  sourceSong     Song     @relation("SourceSongStems", fields: [sourceSongId], references: [id], onDelete: Cascade)
  kind           StemKind
  derivedSongId  String?
  derivedSong    Song?    @relation("DerivedSongStems", fields: [derivedSongId], references: [id], onDelete: SetNull)
  producerId     String
  producer       User     @relation(fields: [producerId], references: [id], onDelete: Cascade)
  shareBps       Int      @default(200)
  createdAt      DateTime @default(now())
  @@index([sourceSongId])
  @@index([derivedSongId])
  @@index([producerId])
}

model LicenseToken {
  id          String        @id @default(cuid())
  tokenNumber Int
  status      LicenseStatus @default(ACTIVE)
  purchasedAt DateTime      @default(now())
  price       Decimal       @db.Decimal(10, 2)
  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  holderId String
  holder   User   @relation(fields: [holderId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payouts      Payout[]
  @@unique([songId, tokenNumber])
  @@index([holderId])
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Transaction {
  id       String          @id @default(cuid())
  amount   Decimal         @db.Decimal(10, 2)
  currency String          @default("usd")
  type     TransactionType
  status   PaymentStatus   @default(PENDING)
  stripePaymentIntentId String? @unique
  stripeSessionId       String? @unique
  metadata              Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String?
  song   Song?   @relation(fields: [songId], references: [id])
  licenseTokenId String?
  licenseToken   LicenseToken? @relation(fields: [licenseTokenId], references: [id])
  revenueEvent   RevenueEvent?
  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([songId, status])
}

enum TransactionType {
  LICENSE_PURCHASE
  REVENUE_PAYOUT
  SUBSCRIPTION
  BOOST
  TIP
  AUCTION_WIN
  SERVICE_PURCHASE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payout {
  id        String       @id @default(cuid())
  amount    Decimal      @db.Decimal(10, 2)
  currency  String       @default("usd")
  period    String
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String?
  song   Song?   @relation(fields: [songId], references: [id])
  licenseTokenId String?
  licenseToken   LicenseToken? @relation(fields: [licenseTokenId], references: [id])
  splits         RevenueSplit[]
  stripeTransferId String?    @unique
  failures       PayoutFailure[]
  @@unique([userId, period])
  @@index([userId])
  @@index([status])
  @@index([period])
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  source      String   // "stripe" | "livekit" | etc
  eventId     String
  processedAt DateTime @default(now())

  @@unique([source, eventId])
  @@index([processedAt])
}

model PayoutFailure {
  id        String   @id @default(cuid())
  userId    String
  payoutId  String?
  payout    Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  period    String
  amountCents Int
  reason    String   @db.Text
  retried   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([period])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum District {
  INDIE_BLOCKS
  DOWNTOWN_PRIME
  LABEL_ROW
}

model Studio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  bio         String?  @db.Text
  district    District @default(INDIE_BLOCKS)
  level       Int      @default(1)
  bannerUrl   String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Server-side persistence for an in-progress DAW session. Mirrors what
// the client used to keep only in IndexedDB so the same project resumes
// across devices. Audio bytes live in Vercel Blob; row stores metadata
// + the parameter state (BPM, kit, beat pattern) as JSON.
model StudioProject {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(120)
  bpm            Int           @default(120)
  trackCount     Int           @default(0)
  // Snapshot of beat pattern + transport (active bank, kit, etc.) and
  // any non-track engine state. Validated server-side at save time.
  patternJson    Json?
  // Pre-computed waveform peaks for the hub thumbnail. Roughly 60 floats.
  thumbnailPeaks Json?
  // Public read-only share link (#9). When true, the listen page is
  // accessible without auth via /studio/listen/[id].
  isPublic       Boolean       @default(false)
  // AI-generated cover art (#5) saved alongside the published render.
  coverArtUrl    String?
  // Optional pointer to the rendered master bounce, set on publish so the
  // listen page (#9) has audio to play even before tracks are paginated in.
  masterBlobUrl  String?
  // True when this project is saved as a personal template (#22). Templates
  // show up in the TemplatePicker under "My templates" and never autosave
  // edits back over the original — opening a template clones it to a new
  // project id so the source is preserved.
  isTemplate     Boolean       @default(false)
  // Optional genre tag for templates so the picker can group them.
  templateGenre  String?
  // Price in USD to license this template to another producer (#28).
  // null = not for sale (default). 0 = free download. >0 = paid.
  // The marketplace listing is implied by isTemplate=true AND
  // templatePriceUsd != null; isPublic stays orthogonal so a producer
  // can publish a template without marketing it on their feed.
  templatePriceUsd Decimal?    @db.Decimal(10, 2)
  tracks         StudioTrack[]
  versions       StudioProjectVersion[] @relation("ProjectVersions")
  // Back-relation for the live room currently broadcasting this
  // project. Null when the project isn't being collab'd live.
  liveRoom       Room?         @relation("RoomStudioProject")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([userId, updatedAt])
  @@index([isPublic])
  @@index([isTemplate])
}

model StudioTrack {
  id          String        @id @default(cuid())
  projectId   String
  project     StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String        @db.VarChar(80)
  color       String        @db.VarChar(16)
  // Public Vercel Blob URL for this track's audio. Null while a track is
  // empty (no recording yet). Removed via the Blob delete API on project
  // delete (Prisma cascade only handles the row, not the blob).
  blobUrl     String?
  durationSec Float         @default(0)
  // Stable ordering — engine adds tracks in a deterministic sequence.
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([projectId, position])
}

// Snapshot of a project at a point in time. Saved-on-autosave (last 10
// retained per project) so users can rewind through "version history"
// without paying the full undo-stack IDB cost. Just metadata + the
// pattern/transport JSON; track audio blobs aren't duplicated (rewinding
// to a snapshot keeps current audio, only restores engine state). This
// is intentionally simple — full audio time-travel would balloon storage
// without proportionate value.
model StudioProjectVersion {
  id          String   @id @default(cuid())
  projectId   String
  project     StudioProject @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  // Saved-state JSON: bpm, beat pattern, transport snapshot, etc.
  // Loaded back into the engine via hydrateProject(). Matches the
  // patternJson shape on StudioProject.
  patternJson Json
  // Stable trackCount + bpm pulled out for the version-list summary so
  // rendering the picker doesn't require parsing patternJson.
  bpm         Int      @default(120)
  trackCount  Int      @default(0)
  // Optional label so power users can name a version ("Pre-master mix").
  label       String?  @db.VarChar(80)
  createdAt   DateTime @default(now())
  @@index([projectId, createdAt])
}

// Producer-uploaded drum kit pack (#29). Each pack is a JSON manifest
// of lane → public sample URL pairs the studio loads in one click.
// Authors publish for promo (free) or set a price (marketplace listing).
model DrumKitPack {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation("DrumKitPacks", fields: [authorId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(120)
  description  String?  @db.Text
  // Genre tag for filtering: "trap" | "drill" | "afro" | "house" | etc.
  genre        String?  @db.VarChar(40)
  // BPM range the kit was tuned at (informational; doesn't gate use).
  bpm          Int?
  // Cover-art image URL (Vercel Blob). Optional.
  coverUrl     String?
  // Lane → sample URL map: { kick: "https://...wav", snare: "..." }.
  // Validated server-side against DRUM_LANES.
  samples      Json
  // 0 = free download, >0 = paid pack. NULL = not listed yet (draft).
  priceUsd     Decimal? @db.Decimal(10, 2)
  // True when the author has flipped the pack public. False = draft.
  isPublic     Boolean  @default(false)
  // Featured packs surface at the top of the marketplace browse modal.
  // Editor-set, not user-controllable.
  isFeatured   Boolean  @default(false)
  downloadCount Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([isPublic, isFeatured])
  @@index([authorId])
  @@index([genre])
}

model VersusMatch {
