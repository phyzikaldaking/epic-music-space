// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  username         String?          @unique
  image            String?
  passwordHash     String?
  role             Role             @default(LISTENER)
  subscriptionTier SubscriptionTier @default(FREE)
  stripeCustomerId String?          @unique
  emailVerified    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  trialExpiresAt   DateTime?
  stripeConnectId  String?          @unique

  // ── Redeem-code grants ─────────────────────────────────────
  // Stackable rewards from /redeem. Kept on the user (vs. a separate
  // entitlements table) because they're per-account counters that
  // never expire on their own — the consume sites decrement them.
  // Reset to 0 only on hard suspend; subscription downgrades don't
  // clear granted slots (we promised them, we keep them).
  bonusSongSlots         Int @default(0)  // adds to maxSongs
  freeBoostCredits       Int @default(0)  // 1 free Boost per credit
  freeLicenseFeeWaivers  Int @default(0)  // 1 fee-free license sale per

  // ── Activity ───────────────────────────────────────────────
  // Bumped whenever the user opens the dashboard. Powers the "since you
  // last visited" summary that's shown on next dashboard load.
  lastSeenAt         DateTime?

  // ── Risk / trust ───────────────────────────────────────────
  // suspicionScore: additive int bumped by webhooks and admin actions.
  // flaggedAt: first time score exceeded threshold or admin manually flagged.
  // isSuspended: hard block — all sensitive actions rejected.
  // emailBounced: Resend bounce/complaint webhook sets this; suppresses future sends.
  suspicionScore  Int       @default(0)
  flaggedAt       DateTime?
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?   @db.Text
  emailBounced    Boolean   @default(false)
  emailBouncedAt  DateTime?

  // Session-revocation marker. JWTs issued before this timestamp are
  // treated as signed-out by the session callback. Set whenever we want
  // every existing session for this user to die — password reset,
  // suspend, admin-forced sign-out, etc.
  sessionsRevokedAt DateTime?

  // ── Identity / verification ────────────────────────────────
  // Verified-artist badge. Set by an admin via /api/admin/users/[id]/verify.
  isVerified         Boolean  @default(false)
  verifiedAt         DateTime?
  // Stripe Identity verification — separate from the verified-artist
  // badge. Used for KYC-grade gating on Connect payouts above platform
  // thresholds. Webhook flips identityVerifiedAt when the verification
  // session reports `verified`.
  stripeIdentitySessionId String?  @unique
  identityVerifiedAt      DateTime?

  // ── Stripe Connect compliance ──────────────────────────────
  connectChargesEnabled Boolean  @default(false)
  connectPayoutsEnabled Boolean  @default(false)
  connectRequirements   Json?    // Stripe requirements object (currently_due, errors, etc.)
  connectCountry        String?  // ISO 3166-1 alpha-2 from Stripe account

  // ── Tax compliance ─────────────────────────────────────────
  taxFormStatus TaxFormStatus @default(NOT_COLLECTED)
  taxIdType     String?       // e.g. "us_ein", "us_ssn", "gb_vat", "eu_vat"

  accounts Account[]
  sessions Session[]
  songs        Song[]
  licenses     LicenseToken[]
  // Stems this user has pulled from the Loop Browser into their tracks.
  stemUsages   StemUsage[]
  // Songs this user has expressed interest in becoming a co-writer on.
  coWriterInterest CoWriterInterest[]
  transactions Transaction[]
  payouts      Payout[]
  studio           Studio?
  podcastShows     PodcastShow[]    @relation("PodcastShowOwner")
  podcastEpisodes  PodcastEpisode[] @relation("PodcastEpisodeCreator")
  ownedLabel       Label?         @relation("LabelOwner")
  labelMemberships LabelArtist[]  @relation("LabelArtistUser")
  adPlacements     AdPlacement[]
  notifications    Notification[]
  versusVotes      VersusVote[]
  battlesCreated   BattleRoyale[]     @relation("BattleRoyaleCreator")
  royaleVotes      BattleRoyaleVote[] @relation("BattleRoyaleVotes")
  following        UserFollow[]   @relation("Follower")
  followers        UserFollow[]   @relation("Following")
  inviteCodesCreated InviteCode[] @relation("InviteCreator")
  inviteCodeUsed     InviteCode?  @relation("InviteUsed")
  badges UserBadge[]
  auctionsCreated Auction[]    @relation("AuctionSeller")
  auctionsWon     Auction[]    @relation("AuctionWinner")
  auctionBids     AuctionBid[] @relation("AuctionBidder")
  behaviorEvents  UserBehaviorEvent[]
  tasteProfile    UserTasteProfile?
  roomsHosted        Room[]              @relation("RoomHost")
  roomParticipations RoomParticipant[]
  roomMessages       RoomMessage[]
  roomTimelineNotes  RoomTimelineNote[]
  roomBans           RoomBan[]           @relation("RoomBanned")
  roomBansIssued     RoomBan[]           @relation("RoomBannedBy")
  revenueSplits      RevenueSplit[]      @relation("RevenueSplits")
  serviceListings    ServiceListing[]    @relation("ServiceProvider")
  serviceOrdersAsBuyer    ServiceOrder[] @relation("ServiceBuyer")
  serviceOrdersAsProvider ServiceOrder[] @relation("ServiceProviderOrders")
  serviceMessages    ServiceOrderMessage[] @relation("ServiceMessageAuthor")
  serviceReviews     ServiceReview[]    @relation("ServiceReviewer")
  posts              Post[]             @relation("PostAuthor")
  postComments       PostComment[]      @relation("PostCommentAuthor")
  postLikes          PostLike[]         @relation("PostLikeUser")
  trackComments      TrackComment[]     @relation("TrackCommentAuthor")
  trackLikes         TrackLike[]        @relation("TrackLikeUser")
  connectedAccounts  ConnectedAccount[]
  blocking           UserBlock[]        @relation("Blocker")
  blockedBy          UserBlock[]        @relation("Blocked")
  reportsFiled       UserReport[]       @relation("Reporter")
  reportsReceived    UserReport[]       @relation("Reported")
  notifPrefs         NotificationPreference[]
  conversationsAsA   Conversation[]     @relation("ConversationUserA")
  conversationsAsB   Conversation[]     @relation("ConversationUserB")
  messagesSent       Message[]          @relation("MessageSender")
  verzuzAsArtistA    VerzuzMatch[]      @relation("VerzuzArtistA")
  verzuzAsArtistB    VerzuzMatch[]      @relation("VerzuzArtistB")
  verzuzVotes        VerzuzVote[]
  verzuzRSVPs        VerzuzRSVP[]
  verzuzReactions    VerzuzReaction[]
  verzuzMessages     VerzuzMessage[]
  pushTokens         PushToken[]

  // ── Pro profile (engineers / producers) ────────────────────
  // Cinematic profile fields surfaced on /pro/[username]. Bio is short
  // — `headline` is the one-line tagline ("Grammy-nominated mix engineer
  // for Beyoncé, SZA"), `bioLong` is the full story, `coverImage` is the
  // wide cinematic banner behind the avatar.
  headline      String?  @db.VarChar(160)
  bioLong       String?  @db.Text
  coverImage    String?
  location      String?  @db.VarChar(120)
  websiteUrl    String?
  instagramUrl  String?
  twitterUrl    String?
  youtubeUrl    String?
  tiktokUrl     String?
  spotifyUrl    String?
  // Industry accolades counters (signed off by admin via UserBadge — these
  // are the public marquee numbers: "5x Grammy nominated, 3 wins, 12 Platinum").
  grammyNominations  Int @default(0)
  grammyWins         Int @default(0)
  riaaPlatinum       Int @default(0)
  riaaGold           Int @default(0)
  billboardNumberOne Int @default(0)
  // Free-form list of credits as JSON: [{ artist, title, role, year, coverUrl, spotifyUrl }]
  // Validated server-side in /api/user/profile. Capped at 50 entries.
  engineerCredits  Json?
  // Free-form list of accolades as JSON: [{ title, year, org, kind: "grammy"|"riaa-platinum"|"riaa-gold"|"billboard"|"other" }]
  engineerAccolades Json?
  // Studio / gear specs as JSON: { console, monitors, daws: string[], plugins: string[], roomTreatment }
  engineerGear Json?
  // Years of experience — surfaced in the badge wall.
  yearsExperience Int?
  // When true, the profile shows the cinematic hero treatment. Defaults
  // off for legacy users; engineers/producers can flip it on once they've
  // populated headline + cover + at least 3 credits.
  proProfilePublished Boolean @default(false)
}

enum Role {
  LISTENER
  ARTIST
  PRODUCER
  ENGINEER
  LABEL
  ADMIN
}

enum TaxFormStatus {
  NOT_COLLECTED
  PENDING
  COLLECTED
  EXEMPT
}

enum SubscriptionTier {
  FREE
  TRIAL
  STARTER
  PRO
  PRIME
  TEAM
  LABEL_TIER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

// Connected third-party social accounts that can be used to post on behalf
// of a user. Tokens are stored encrypted in the application DB.
model ConnectedAccount {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  providerAccountId  String
  accessToken        String?  @db.Text
  refreshToken       String?  @db.Text
  expiresAt          Int?
  scope              String?
  meta               Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique  // sha256 of the raw token; raw value is only emailed
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expires])
}

model Song {
  id          String  @id @default(cuid())
  title       String
  artist      String
  genre       String?
  description String? @db.Text
  audioUrl    String
  coverUrl    String?
  bpm         Int?
  key         String?
  licensePrice    Decimal @db.Decimal(10, 2)
  revenueSharePct Decimal @db.Decimal(5, 2)
  totalLicenses   Int     @default(100)
  soldLicenses    Int     @default(0)
  isActive        Boolean @default(true)
  aiScore      Float    @default(0)
  boostScore   Float    @default(0)
  versusWins   Int      @default(0)
  versusLosses Int      @default(0)
  streamCount  Int      @default(0)
  // Track-page views (distinct from streamCount, which counts /stream hits).
  // Lets producers compute a real funnel: viewCount -> streamCount -> licenses.
  viewCount    Int      @default(0)
  // Drafts + scheduled releases. isDraft=true keeps the song out of every
  // public surface (marketplace, trending, profile, search). scheduledAt
  // is the timestamp a cron flips isDraft -> false. Both honor the existing
  // isActive flag, which remains the producer's manual on/off switch.
  isDraft      Boolean  @default(false)
  scheduledAt  DateTime?
  // License tier variants (basic/premium/exclusive/etc.). When set, the
  // top-level licensePrice is the BASIC tier and this JSON describes
  // additional tiers. Shape: [{ id, name, priceUsd, terms, totalLicenses }].
  licenseVariants Json?
  district     District @default(INDIE_BLOCKS)
  stemUrl   String?
  stemFiles Json?
  hasStems  Boolean @default(false)
  // AI stem separation lifecycle. Populated when the artist (or a license
  // holder) hits "Generate stems" — we kick off a Demucs job on Replicate
  // and store the resulting 4 stems (vocals, drums, bass, other) into
  // stemFiles + flip hasStems=true on success.
  stemSeparationStatus      StemSeparationStatus @default(NONE)
  stemSeparationProviderId  String?
  stemSeparationError       String?
  stemSeparationStartedAt   DateTime?
  stemSeparationCompletedAt DateTime?
  // When false (default), the audio file is preview-only. Listeners can stream
  // through the proxy but cannot download the underlying file. License
  // purchase or artist opt-in (true) is required for download.
  allowFreeDownload Boolean @default(false)
  // Pay-what-you-want pricing. When ON, licensePrice is treated as the
  // minimum floor and fans pick any amount ≥ floor at checkout. The track
  // page renders an amount input instead of a fixed buy button. Off by
  // default; producers explicitly opt in when they want the tip-jar /
  // superfan model. Stripe checkout receives the chosen amount as a
  // dynamic price_data line item rather than a fixed product price.
  payWhatYouWant Boolean @default(false)
  // Legacy / vault tracks: older catalog material (e.g. "back when I used to
  // rap"). Rendered in a separate Legacy section on /studio/[username] and
  // excluded from /trending + /marketplace defaults so the new-releases
  // surface stays current.
  isLegacy            Boolean @default(false)
  originalReleaseYear Int?    // optional context for legacy tracks (e.g. 2003)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artistId String
  artist_  User   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  licenses       LicenseToken[]
  transactions   Transaction[]
  payouts        Payout[]
  versusMatchesA VersusMatch[]       @relation("VersusA")
  versusMatchesB VersusMatch[]       @relation("VersusB")
  verzuzRoundsA  VerzuzRound[]       @relation("VerzuzRoundSongA")
  verzuzRoundsB  VerzuzRound[]       @relation("VerzuzRoundSongB")
  royaleEntries  BattleRoyaleEntry[] @relation("BattleRoyaleEntries")
  auctions       Auction[]
  behaviorEvents UserBehaviorEvent[]
  rooms          Room[]
  revenueEvents  RevenueEvent[]
  trackComments  TrackComment[]
  trackLikes     TrackLike[]
  // Stems of this song that have been pulled into other producers' tracks.
  stemUsagesAsSource  StemUsage[] @relation("SourceSongStems")
  // Stems from other songs that this song was built from.
  stemUsagesAsDerived StemUsage[] @relation("DerivedSongStems")
  // Fans who tapped "Become a Co-Writer" on this song. The artist
  // reviews the queue and accepts/declines; on accept a real writer
  // share is minted via the existing license/payout pipeline.
  coWriterInterest    CoWriterInterest[]
  @@index([artistId])
  @@index([district])
  @@index([isActive])
  @@index([aiScore])
  @@index([isActive, aiScore, createdAt])
  @@index([isActive, genre])
  @@index([isActive, bpm])
  @@index([stemSeparationStatus])
  // Drafts + scheduled releases — used by the publish-scheduled-tracks cron
  // and by the producer "drafts" tab on /studio/manage.
  @@index([isDraft])
  @@index([scheduledAt])
}

enum StemSeparationStatus {
  NONE
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum StemKind {
  VOCALS
  DRUMS
  BASS
  OTHER
  FULL
}

// Captured intent only — Stripe checkout for the actual purchase
// happens in a follow-up flow. Status values are loose strings rather
// than an enum so we can iterate the workflow without migrations:
// PENDING / ACCEPTED / DECLINED / PAID / EXPIRED.
model CoWriterInterest {
  id                String   @id @default(cuid())
  songId            String
  song              Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  fanId             String
  fan               User     @relation(fields: [fanId], references: [id], onDelete: Cascade)
  shareBpsRequested Int      @default(50)
  priceCents        Int      @default(5000)
  message           String?
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([songId, fanId])
  @@index([songId, status])
  @@index([fanId])
}

// When a producer drags a stem from the Loop Browser into their DAW,
// a StemUsage row is created. The derived song id is filled in when
// they publish the resulting track via /studio/new. The royalty
// waterfall job uses these rows to split future revenue back to the
// source artists (shareBps = basis points, default 200 = 2% per stem).
model StemUsage {
  id             String   @id @default(cuid())
  sourceSongId   String
  sourceSong     Song     @relation("SourceSongStems", fields: [sourceSongId], references: [id], onDelete: Cascade)
  kind           StemKind
  derivedSongId  String?
  derivedSong    Song?    @relation("DerivedSongStems", fields: [derivedSongId], references: [id], onDelete: SetNull)
  producerId     String
  producer       User     @relation(fields: [producerId], references: [id], onDelete: Cascade)
  shareBps       Int      @default(200)
  createdAt      DateTime @default(now())
  @@index([sourceSongId])
  @@index([derivedSongId])
  @@index([producerId])
}

model LicenseToken {
  id          String        @id @default(cuid())
  tokenNumber Int
  status      LicenseStatus @default(ACTIVE)
  purchasedAt DateTime      @default(now())
  price       Decimal       @db.Decimal(10, 2)
  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  holderId String
  holder   User   @relation(fields: [holderId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payouts      Payout[]
  @@unique([songId, tokenNumber])
  @@index([holderId])
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Transaction {
  id       String          @id @default(cuid())
  amount   Decimal         @db.Decimal(10, 2)
  currency String          @default("usd")
  type     TransactionType
  status   PaymentStatus   @default(PENDING)
  stripePaymentIntentId String? @unique
  stripeSessionId       String? @unique
  metadata              Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String?
  song   Song?   @relation(fields: [songId], references: [id])
  licenseTokenId String?
  licenseToken   LicenseToken? @relation(fields: [licenseTokenId], references: [id])
  revenueEvent   RevenueEvent?
  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([songId, status])
}

enum TransactionType {
  LICENSE_PURCHASE
  REVENUE_PAYOUT
  SUBSCRIPTION
  BOOST
  TIP
  AUCTION_WIN
  SERVICE_PURCHASE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payout {
  id        String       @id @default(cuid())
  amount    Decimal      @db.Decimal(10, 2)
  currency  String       @default("usd")
  period    String
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId String?
  song   Song?   @relation(fields: [songId], references: [id])
  licenseTokenId String?
  licenseToken   LicenseToken? @relation(fields: [licenseTokenId], references: [id])
  splits         RevenueSplit[]
  stripeTransferId String?    @unique
  failures       PayoutFailure[]
  @@unique([userId, period])
  @@index([userId])
  @@index([status])
  @@index([period])
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  source      String   // "stripe" | "livekit" | etc
  eventId     String
  processedAt DateTime @default(now())

  @@unique([source, eventId])
  @@index([processedAt])
}

model PayoutFailure {
  id        String   @id @default(cuid())
  userId    String
  payoutId  String?
  payout    Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  period    String
  amountCents Int
  reason    String   @db.Text
  retried   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([period])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum District {
  INDIE_BLOCKS
  DOWNTOWN_PRIME
  LABEL_ROW
}

model Studio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String   @unique
  bio         String?  @db.Text
  district    District @default(INDIE_BLOCKS)
  level       Int      @default(1)
  bannerUrl   String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VersusMatch {
  id        String       @id @default(cuid())
  songAId   String
  songBId   String
  songA     Song         @relation("VersusA", fields: [songAId], references: [id], onDelete: Cascade)
  songB     Song         @relation("VersusB", fields: [songBId], references: [id], onDelete: Cascade)
  votesA    Int          @default(0)
  votesB    Int          @default(0)
  status    VersusStatus @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime     @default(now())
  votes VersusVote[]
  @@index([status])
  @@index([endsAt])
  @@index([songAId])
  @@index([songBId])
}

enum VersusStatus {
  ACTIVE
  COMPLETED
}

model VersusVote {
  id          String      @id @default(cuid())
  matchId     String
  match       VersusMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  votedSongId String
  createdAt DateTime @default(now())
  @@unique([matchId, userId])
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  ownerId     String   @unique
  owner       User     @relation("LabelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  logoUrl     String?
  bio         String?  @db.Text
  revSharePct Decimal  @default(10) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artists LabelArtist[]
}

model LabelArtist {
  id          String            @id @default(cuid())
  labelId     String
  label       Label             @relation(fields: [labelId], references: [id], onDelete: Cascade)
  artistId    String
  artist      User              @relation("LabelArtistUser", fields: [artistId], references: [id], onDelete: Cascade)
  revSharePct Decimal           @db.Decimal(5, 2)
  status      LabelArtistStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  @@unique([labelId, artistId])
}

enum LabelArtistStatus {
  PENDING
  ACTIVE
  TERMINATED
}

model AdPlacement {
  id        String     @id @default(cuid())
  location  AdLocation
  title     String
  mediaUrl  String
  linkUrl   String?
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  price     Decimal    @db.Decimal(10, 2)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  impressions AdImpression[]
  clicks      AdClick[]
  revenueEvents RevenueEvent[] @relation("AdPlacementRevenue")

  @@index([location, isActive, startDate, endDate])
  @@index([ownerId])
}

model AdImpression {
  id          String   @id @default(cuid())
  placementId String
  placement   AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  userId      String?
  sessionId   String?      // anonymous client UUID stored in localStorage
  ipHash      String?      // sha256(ip + daily salt) — privacy-preserving fraud guard
  userAgent   String?      @db.Text
  referrer    String?      @db.Text
  createdAt   DateTime     @default(now())

  @@index([placementId, createdAt])
  @@index([userId, createdAt])
  @@index([ipHash, placementId, createdAt])
}

model AdClick {
  id          String   @id @default(cuid())
  placementId String
  placement   AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  userId      String?
  sessionId   String?
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([placementId, createdAt])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Revenue share + payout ledger
// ─────────────────────────────────────────────────────────────

model RevenueEvent {
  id           String           @id @default(cuid())
  type         RevenueEventType
  // Source pointers — at most one filled in (denormalized for fast filtering).
  songId       String?
  song         Song?            @relation(fields: [songId], references: [id], onDelete: SetNull)
  transactionId String?         @unique
  transaction  Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  adPlacementId String?
  adPlacement   AdPlacement?    @relation("AdPlacementRevenue", fields: [adPlacementId], references: [id], onDelete: SetNull)
  grossCents   Int              // gross revenue in cents (USD)
  feeCents     Int              @default(0)  // Stripe / processor fees
  currency     String           @default("usd")
  occurredAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  splits       RevenueSplit[]

  @@index([type, occurredAt])
  @@index([songId, occurredAt])
}

enum RevenueEventType {
  LICENSE_SALE
  TIP
  AD_PURCHASE
  STREAM_ROYALTY
  AUCTION_WIN
  BOOST
  SUBSCRIPTION
  SERVICE_SALE
  REFUND        // negative gross — clawback
}

model RevenueSplit {
  id        String           @id @default(cuid())
  eventId   String
  event     RevenueEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("RevenueSplits", fields: [userId], references: [id], onDelete: Cascade)
  role      RevenueSplitRole
  amountCents Int            // can be negative for clawbacks
  status    RevenueSplitStatus @default(PENDING)
  payoutId  String?
  payout    Payout?          @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  paidAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status])
  @@index([eventId])
  @@index([payoutId])
}

enum RevenueSplitRole {
  ARTIST
  HOLDER
  LABEL
  PLATFORM
  HOST          // listening-session host
}

enum RevenueSplitStatus {
  PENDING       // accrued, not yet paid
  PAID          // included in a Payout that succeeded
  CLAWED_BACK   // refund/dispute reversed it
  EXCLUDED      // platform fee, not actually paid out
}

enum AdLocation {
  MARKETPLACE_BANNER
  STUDIO_SIDEBAR
  CITY_BILLBOARD
  VERSUS_BANNER
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([userId, read])
  @@index([userId, createdAt])
}

// Per-user, per-type notification preferences. Missing rows default to
// "enabled" so the UI only needs to write when a user opts out.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // POST_LIKED | POST_COMMENTED | FOLLOWED_POST | FOLLOW | LICENSE_SOLD | …
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([userId, type])
  @@index([userId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
  @@index([followingId])
}

// One user blocking another. When A blocks B, B's posts are filtered out
// of A's feed and B can't comment on or like A's posts. Mute is similar
// but only hides — it doesn't prevent B's interactions.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Append-only record of every admin moderation action. Lets us answer
// "who actioned what, when, why?" forever — even after the underlying
// report row is gone or the offending content is hard-deleted.
model ModerationAction {
  id          String   @id @default(cuid())
  actorId     String   // user who took the action (admin)
  // Subject of the action — exactly one will be set.
  reportId    String?
  postId      String?
  subjectUserId String?
  // Verb — small enum so we can render filters and trends.
  action      String   // REPORT_DISMISSED | REPORT_REVIEWED | REPORT_ACTIONED |
                       // POST_UNPUBLISHED | USER_VERIFIED | USER_UNVERIFIED |
                       // SONG_DELETED | USER_BANNED | …
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([reportId])
  @@index([postId])
  @@index([subjectUserId])
  @@index([action, createdAt])
}

// User-submitted moderation report — feeds the admin queue.
model UserReport {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  // The thing being reported. Exactly one of (reportedUserId, postId) is set.
  reportedUserId String?
  reportedUser   User?  @relation("Reported", fields: [reportedUserId], references: [id], onDelete: SetNull)
  postId      String?
  reason      String   // "SPAM" | "ABUSE" | "IMPERSONATION" | "NSFW" | "OTHER"
  details     String?  @db.Text
  status      String   @default("PENDING") // PENDING | REVIEWED | DISMISSED | ACTIONED
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([postId])
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedById String? @unique
  usedBy   User?   @relation("InviteUsed", fields: [usedById], references: [id])
}

model UserBadge {
  id        String    @id @default(cuid())
  type      BadgeType
  awardedAt DateTime  @default(now())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type])
}

enum BadgeType {
  EARLY_ADOPTER
  INVITE_5
  INVITE_10
  INVITE_50
  FIRST_BATTLE_WIN
  FIRST_LICENSE_SOLD
  LICENSE_HOLDER
  TOP_ARTIST
}

model Auction {
  id       String @id @default(cuid())
  songId   String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  sellerId String
  seller   User   @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  startingBid  Decimal  @db.Decimal(10, 2)
  reservePrice Decimal? @db.Decimal(10, 2)
  currentBid   Decimal? @db.Decimal(10, 2)
  // Optional "buy it now" — when set and a bid >= this amount lands, the
  // auction settles immediately at that price.
  instantBuyPrice Decimal? @db.Decimal(10, 2)
  // Anti-snipe controls. windowMinutes: if a bid lands within this many
  // minutes of endsAt, extend by extensionMinutes. Defaults match the
  // previous hardcoded 2/2 behaviour in the bid route.
  antiSnipeWindowMinutes    Int @default(2)
  antiSnipeExtensionMinutes Int @default(2)
  // Soft "ending soon" notification timestamp — flipped by the cron so we
  // don't re-notify when anti-snipe extends past the original window.
  endingSoonNotifiedAt DateTime?
  winnerId String?
  winner   User?   @relation("AuctionWinner", fields: [winnerId], references: [id])
  status    AuctionStatus @default(ACTIVE)
  endsAt    DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bids AuctionBid[]
  @@index([status, endsAt])
  @@index([songId])
  @@index([sellerId])
  @@index([sellerId, status])
}

enum AuctionStatus {
  ACTIVE
  ENDED
  SETTLED
  EXPIRED
  CANCELLED
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation("AuctionBidder", fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  @@index([auctionId, amount(sort: Desc)])
  @@index([bidderId])
}

model BattleRoyale {
  id        String              @id @default(cuid())
