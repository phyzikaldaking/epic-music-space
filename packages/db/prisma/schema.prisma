  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model PostLike {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// ─────────────────────────────────────────
// TRACK COMMENTS & LIKES
// ─────────────────────────────────────────

model TrackComment {
  id       String   @id @default(cuid())
  songId   String
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  authorId String
  author   User     @relation("TrackCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body     String   @db.Text
  createdAt DateTime @default(now())

  @@index([songId, createdAt])
}

model TrackLike {
  id       String   @id @default(cuid())
  songId   String
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("TrackLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

