  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
  @@index([followingId])
}

// One user blocking another. When A blocks B, B's posts are filtered out
// of A's feed and B can't comment on or like A's posts. Mute is similar
// but only hides — it doesn't prevent B's interactions.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Append-only record of every admin moderation action. Lets us answer
// "who actioned what, when, why?" forever — even after the underlying
// report row is gone or the offending content is hard-deleted.
model ModerationAction {
  id          String   @id @default(cuid())
  actorId     String   // user who took the action (admin)
  // Subject of the action — exactly one will be set.
  reportId    String?
  postId      String?
  subjectUserId String?
  // Verb — small enum so we can render filters and trends.
  action      String   // REPORT_DISMISSED | REPORT_REVIEWED | REPORT_ACTIONED |
                       // POST_UNPUBLISHED | USER_VERIFIED | USER_UNVERIFIED |
                       // SONG_DELETED | USER_BANNED | …
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([reportId])
  @@index([postId])
  @@index([subjectUserId])
  @@index([action, createdAt])
}

// User-submitted moderation report — feeds the admin queue.
model UserReport {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  // The thing being reported. Exactly one of (reportedUserId, postId) is set.
  reportedUserId String?
  reportedUser   User?  @relation("Reported", fields: [reportedUserId], references: [id], onDelete: SetNull)
  postId      String?
  reason      String   // "SPAM" | "ABUSE" | "IMPERSONATION" | "NSFW" | "OTHER"
  details     String?  @db.Text
  status      String   @default("PENDING") // PENDING | REVIEWED | DISMISSED | ACTIONED
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([postId])
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  createdById String
