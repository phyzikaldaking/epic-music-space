# ─────────────────────────────────────────────────────────────
# Epic Music Space — Environment Variables
# Copy this file to .env.local (web app) and fill in real values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://epicmusicspace.com
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
SITE_URL=https://your-domain.vercel.app

# NextAuth v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET=your_nextauth_secret_here
AUTH_URL=https://your-domain.vercel.app
NEXTAUTH_URL=https://your-domain.vercel.app

# ── Database ─────────────────────────────────────────────────
# Supabase: Settings > Database > Connection string > Transaction mode (port 6543)
# Add ?pgbouncer=true&connection_limit=1 for serverless
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Supabase: Settings > Database > Connection string > Session mode (port 5432)
# Used by Prisma migrate — bypasses PgBouncer for direct DDL access
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────
# Project URL — found in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/public key — safe to expose in the browser (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key — server-only, bypasses RLS (Storage uploads, realtime broadcast)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Stripe ───────────────────────────────────────────────────
# Secret key — server-only
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook signing secret — from the Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Subscription price IDs (create in Stripe Dashboard > Products)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_PRIME=price_...
STRIPE_PRICE_ID_TEAM=price_...
STRIPE_PRICE_ID_LABEL=price_...

# ── Google OAuth ─────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Redis ────────────────────────────────────────────────────
# Upstash Redis URL (used for rate-limiting, caching, BullMQ queues)
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:password@host:6379

# ── Email + Analytics ────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Epic Music Space <noreply@epicmusicspace.com>
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# ── Vercel Cron security ─────────────────────────────────────
CRON_SECRET=your_cron_secret_here

# ── Control Plane Metadata ───────────────────────────────────
# Used by the repo ops scripts for Doppler, GitHub, Vercel, Stripe, and Supabase automation
DOPPLER_PROJECT=epic-music-space
DOPPLER_CONFIG_DEV=dev
DOPPLER_CONFIG_PREVIEW=preview
DOPPLER_CONFIG_PROD=prod
GITHUB_REPOSITORY=phyzikaldaking/epic-music-space
VERCEL_ORG_ID=team_xxx
VERCEL_PROJECT_ID=prj_xxx
SUPABASE_PROJECT_REF=yourprojectref
STRIPE_WEBHOOK_FORWARD_URL=http://localhost:3000/api/webhooks/stripe

# ── OpenAI ───────────────────────────────────────────────────
# Used for AI song scoring, recommendations, and chat assistant
OPENAI_API_KEY=sk-...

# ── LiveKit (live audio rooms / listening sessions) ──────────
# Sign up at https://cloud.livekit.io. The URL is your project's
# WebSocket URL (wss://your-project.livekit.cloud).
# NEXT_PUBLIC_LIVEKIT_URL is exposed to the browser; the API
# key/secret stay server-side and are used to mint join tokens.
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── ElevenLabs (live announcer / TTS) ─────────────────────────
# Optional. When unset, the announcer endpoint returns "browser_fallback".
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_VOICE_ID=

# ── Highlight clips & auto-posting ────────────────────────────
# Optional. Tunes the auto-clip pipeline. Defaults are sensible.
HIGHLIGHT_VIRAL_THRESHOLD=50
HIGHLIGHT_CLIP_DURATION_SECONDS=30
AUTO_RENDER_CLIP_THRESHOLD=25
AUTO_POST_CLIP_THRESHOLD=75
AUTO_POST_PLATFORMS=tiktok,instagram

# ── Ops / payouts ─────────────────────────────────────────────
# Bootstraps the first ADMIN user via /api/admin/bootstrap. Rotate or remove after first use.
ADMIN_BOOTSTRAP_SECRET=
# Webhook called when suspicious auth events fire (Slack/Discord-compatible).
AUTH_ALERT_WEBHOOK_URL=
# Minimum USD a creator must accrue before a payout is issued.
MIN_CREATOR_PAYOUT_USD=20
