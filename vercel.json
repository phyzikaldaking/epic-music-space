{
  "framework": "nextjs",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/expire-battles",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/settle-auctions",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-payouts",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/reconcile-ledger",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/auto-accept-orders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/email-drip",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/cleanup-webhooks",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cleanup-notifications",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * 5"
    },
    {
      "path": "/api/cron/flush-email-outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/advance-verzuz",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/verzuz-pre-start",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/auth-alerts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/synthetic-smoke",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/visual-regression",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/rap-stock-snapshot",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/feedback-extract",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/feedback-rollup",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/beat-embeddings",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/marketing-plan",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/marketing-execute",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/community-engage",
      "schedule": "30 10 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
